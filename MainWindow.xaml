        <Geometry x:Key="IconSun">M12,18A6,6 0 1,0 12,6A6,6 0 0,0 12,18M12,4A1,1 0 0,0 13,3V1H11V3A1,1 0 0,0 12,4M12,20A1,1 0 0,0 11,21V23H13V21A1,1 0 0,0 12,20M4.22,5.64L2.81,4.22L1.39,5.64L2.81,7.05A1,1 0 0,0 4.22,5.64M21.19,18.36L19.78,16.95A1,1 0 0,0 18.36,18.36L19.78,19.78L21.19,18.36M4,12A1,1 0 0,0 3,11H1V13H3A1,1 0 0,0 4,12M23,11H21A1,1 0 0,0 21,13H23V11M5.64,21.19L7.05,19.78A1,1 0 0,0 5.64,18.36L4.22,19.78L5.64,21.19M18.36,5.64A1,1 0 0,0 19.78,7.05L21.19,5.64L19.78,4.22L18.36,5.64Z</Geometry>
