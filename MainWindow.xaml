        <Geometry x:Key="IconShape">M12,2L22,22H2L12,2Z</Geometry>
        <Geometry x:Key="IconTouch">M9,11V7A3,3 0 0,1 15,7V11</Geometry>
        <Geometry x:Key="IconCheck">M21,7L9,19L3.5,13.5L4.91,12.09L9,16.17L19.59,5.59L21,7Z</Geometry>
        <Geometry x:Key="IconMenu">M3,6H21V8H3V6M3,11H21V13H3V11M3,16H21V18H3V16Z</Geometry>
    </Window.Resources>

    <!-- ═══ App Shell: Sidebar | Main Area ═══ -->
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ═══ Sidebar ═══ -->
        <Border x:Name="SidebarBorder" Grid.Column="0" Background="{DynamicResource SidebarBgBrush}"
                Width="220"
                BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="0,0,1,0">
            <DockPanel LastChildFill="True" Margin="0,16">
                <!-- Logo -->
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Top" Margin="12,0,12,12" VerticalAlignment="Center">
                    <Border Width="32" Height="32" CornerRadius="8" Background="{StaticResource AccentBrush}">
                        <TextBlock Text="PT" Foreground="White" FontWeight="Bold" FontSize="16"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="PdfTeachAnnotator" FontWeight="SemiBold" FontSize="15"
                               Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" Margin="10,0,0,0"
                               Visibility="{Binding IsSidebarCollapsed, Converter={StaticResource InverseBoolToVisibilityConverter}}"/>
                </StackPanel>

                <!-- Footer: Theme + Collapse -->
                <Border DockPanel.Dock="Bottom" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="0,1,0,0" Padding="8,8">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" Style="{StaticResource ThemeToggleStyle}" Command="{Binding ToggleThemeCommand}"
                                Visibility="{Binding IsSidebarCollapsed, Converter={StaticResource InverseBoolToVisibilityConverter}}">
                            <Path Fill="{DynamicResource TextSecondaryBrush}" Width="20" Height="20" Stretch="Uniform">
                                <Path.Style>
                                    <Style TargetType="Path">
                                        <Setter Property="Data" Value="{StaticResource IconMoon}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsDarkMode}" Value="True">
                                                <Setter Property="Data" Value="{StaticResource IconSun}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Path.Style>
                            </Path>
                        </Button>
                        <Button Grid.Column="1" Command="{Binding ToggleSidebarCommand}" Width="28" Height="28"
                                ToolTip="折叠/展开侧边栏"
                                HorizontalAlignment="Center">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource NavButtonStyle}">
                                    <Setter Property="Padding" Value="4"/>
                                </Style>
                            </Button.Style>
                            <Path Fill="{DynamicResource TextSecondaryBrush}" Width="16" Height="16" Stretch="Uniform"
                                  Data="{StaticResource IconMenu}"/>
                        </Button>
                    </Grid>
                </Border>

                <!-- Nav -->
                <StackPanel Margin="8,0">
                    <Button Command="{Binding ShowHomeCommand}" ToolTip="主页">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource NavButtonStyle}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsHomeView}" Value="True">
                                        <Setter Property="Background" Value="{StaticResource AccentSoftBrush}"/>
                                        <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Path Data="{StaticResource IconHome}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Width="22" Height="22" Stretch="Uniform"/>
                            <TextBlock Text="主页" Margin="14,0,0,0" VerticalAlignment="Center"
                                       Visibility="{Binding IsSidebarCollapsed, Converter={StaticResource InverseBoolToVisibilityConverter}}"/>
                        </StackPanel>
                    </Button>

                    <Button Command="{Binding ShowToolboxCommand}" ToolTip="工具箱">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource NavButtonStyle}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsToolboxView}" Value="True">
                                        <Setter Property="Background" Value="{StaticResource AccentSoftBrush}"/>
                                        <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Path Data="{StaticResource IconToolbox}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Width="22" Height="22" Stretch="Uniform"/>
                            <TextBlock Text="工具箱" Margin="14,0,0,0" VerticalAlignment="Center"
                                       Visibility="{Binding IsSidebarCollapsed, Converter={StaticResource InverseBoolToVisibilityConverter}}"/>
                        </StackPanel>
                    </Button>

                    <Button Command="{Binding ShowSettingsCommand}" ToolTip="设置">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource NavButtonStyle}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsSettingsView}" Value="True">
                                        <Setter Property="Background" Value="{StaticResource AccentSoftBrush}"/>
                                        <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Path Data="{StaticResource IconSettings}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Width="22" Height="22" Stretch="Uniform"/>
                            <TextBlock Text="设置" Margin="14,0,0,0" VerticalAlignment="Center"
                                       Visibility="{Binding IsSidebarCollapsed, Converter={StaticResource InverseBoolToVisibilityConverter}}"/>
                        </StackPanel>
                    </Button>

                    <Button Command="{Binding ShowAboutCommand}" ToolTip="关于">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource NavButtonStyle}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsAboutView}" Value="True">
                                        <Setter Property="Background" Value="{StaticResource AccentSoftBrush}"/>
                                        <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Path Data="{StaticResource IconInfo}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Width="22" Height="22" Stretch="Uniform"/>
                            <TextBlock Text="关于" Margin="14,0,0,0" VerticalAlignment="Center"
                                       Visibility="{Binding IsSidebarCollapsed, Converter={StaticResource InverseBoolToVisibilityConverter}}"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- ═══ Main Area ═══ -->
        <Grid Grid.Column="1" Background="{DynamicResource SurfaceBaseBrush}">

            <!-- ─── HOME PAGE ─── -->
            <ContentControl Visibility="{Binding IsHomeView, Converter={StaticResource BoolToVisibilityConverter}}">
                <ContentControl.Style>
                    <Style TargetType="ContentControl">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsHomeView}" Value="True">
                                <DataTrigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.25" EasingFunction="{StaticResource EaseFluent}"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </DataTrigger.EnterActions>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </ContentControl.Style>
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="40,32" MaxWidth="960" HorizontalAlignment="Center">

                        <!-- Header -->
                        <StackPanel Margin="0,0,0,32">
                            <TextBlock Text="欢迎回来" FontSize="26" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                            <TextBlock Text="打开您的数字教案，开始批注讲评" FontSize="14" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,4,0,0"/>
                        </StackPanel>

                        <!-- Open / Drag File Card -->
                        <Button Command="{Binding OpenFileCommand}" Cursor="Hand" Margin="0,0,0,32"
                                HorizontalContentAlignment="Stretch">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="Button">
                                                <Border x:Name="Bd" Background="{DynamicResource SurfaceRaisedBrush}"
                                                        BorderBrush="{DynamicResource BorderSubtleBrush}"
                                                        BorderThickness="2" CornerRadius="{StaticResource RadiusLG}"
                                                        Padding="36,28"
                                                        RenderTransformOrigin="0.5,0.5">
                                                    <Border.RenderTransform>
                                                        <TranslateTransform x:Name="T" Y="0"/>
                                                    </Border.RenderTransform>
                                                    <Border.Effect>
                                                        <DropShadowEffect Color="#000000" BlurRadius="8" ShadowDepth="2" Opacity="0.06"/>
                                                    </Border.Effect>
                                                    <ContentPresenter/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                                                        <Trigger.EnterActions>
                                                            <BeginStoryboard>
                                                                <Storyboard>
                                                                    <DoubleAnimation Storyboard.TargetName="T" Storyboard.TargetProperty="Y" To="-2" Duration="0:0:0.2" EasingFunction="{StaticResource EaseFluent}"/>
                                                                </Storyboard>
                                                            </BeginStoryboard>
                                                        </Trigger.EnterActions>
                                                        <Trigger.ExitActions>
                                                            <BeginStoryboard>
                                                                <Storyboard>
                                                                    <DoubleAnimation Storyboard.TargetName="T" Storyboard.TargetProperty="Y" To="0" Duration="0:0:0.2" EasingFunction="{StaticResource EaseFluent}"/>
                                                                </Storyboard>
                                                            </BeginStoryboard>
                                                        </Trigger.ExitActions>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </Button.Style>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <Border Grid.Column="0" Width="56" Height="56" CornerRadius="28" Margin="0,0,20,0"
                                        Background="{StaticResource AccentSoftBrush}" VerticalAlignment="Center">
                                    <Path Data="{StaticResource IconUpload}" Stroke="{StaticResource AccentBrush}" StrokeThickness="2"
                                          Width="24" Height="24" Stretch="Uniform"
                                          HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>

                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="打开或拖入 PDF 文件" FontSize="17" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                    <TextBlock Text="支持 PDF、PPT、DOCX 格式 · 点击浏览" FontSize="14" Foreground="{DynamicResource TextMutedBrush}" Margin="0,4,0,0"/>
                                </StackPanel>

                                <Border Grid.Column="2" Background="{StaticResource AccentBrush}"
                                        CornerRadius="{StaticResource RadiusSM}"
                                        Padding="24,10" VerticalAlignment="Center">
                                    <TextBlock Text="浏览文件" Foreground="White" FontWeight="SemiBold" FontSize="14"/>
                                </Border>
                            </Grid>
                        </Button>

                        <!-- Recent Files Section -->
                        <Border Background="{DynamicResource SurfaceRaisedBrush}"
                                BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1"
                                CornerRadius="{StaticResource RadiusLG}">
                            <Border.Effect>
                                <DropShadowEffect Color="#000000" BlurRadius="8" ShadowDepth="2" Opacity="0.06"/>
                            </Border.Effect>
                            <StackPanel>
                                <!-- Section Header -->
                                <Border BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="0,0,0,1" Padding="24,20">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="最近访问" FontSize="17" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                        <TextBlock Grid.Column="1" FontSize="13" Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center">
                                            <Run Text="{Binding RecentFiles.Count, Mode=OneWay}"/> <Run Text="个文件"/>
                                        </TextBlock>
                                    </Grid>
                                </Border>

                                <!-- Recent Files List -->
                                <ItemsControl ItemsSource="{Binding RecentFiles}" Visibility="{Binding HasRecentFiles, Converter={StaticResource InverseBoolToVisibilityConverter}}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Button Click="RecentFile_Click" Tag="{Binding FilePath}" Cursor="Hand"
                                                    HorizontalContentAlignment="Stretch">
                                                <Button.Style>
                                                    <Style TargetType="Button">
                                                        <Setter Property="Template">
                                                            <Setter.Value>
                                                                <ControlTemplate TargetType="Button">
                                                                    <Border x:Name="Bd" Background="Transparent" Padding="24,14">
                                                                        <ContentPresenter/>
                                                                    </Border>
                                                                    <ControlTemplate.Triggers>
                                                                        <Trigger Property="IsMouseOver" Value="True">
                                                                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SidebarHoverBrush}"/>
                                                                        </Trigger>
                                                                    </ControlTemplate.Triggers>
                                                                </ControlTemplate>
                                                            </Setter.Value>
                                                        </Setter>
                                                    </Style>
                                                </Button.Style>
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>

                                                    <Border Grid.Column="0" Width="40" Height="40" CornerRadius="10" Margin="0,0,14,0"
                                                            Background="#FEE2E2" VerticalAlignment="Center">
                                                        <Path Data="{StaticResource IconPage}" Fill="#EF4444" Width="20" Height="20" Stretch="Uniform"
                                                              HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    </Border>

                                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding FileName}" FontSize="14" FontWeight="Medium"
                                                                   Foreground="{DynamicResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis"/>
                                                        <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                                                            <Path Data="{StaticResource IconClock}" Fill="{DynamicResource TextMutedBrush}" Width="12" Height="12" Stretch="Uniform" VerticalAlignment="Center" Opacity="0.6"/>
                                                            <TextBlock FontSize="12" Foreground="{DynamicResource TextMutedBrush}" Margin="5,0,5,0" VerticalAlignment="Center" Text="{Binding LastAccessed}"/>
                                                            <TextBlock FontSize="12" Foreground="{DynamicResource TextMutedBrush}" Text=" · " VerticalAlignment="Center"/>
                                                            <Path Data="{StaticResource IconPage}" Fill="{DynamicResource TextMutedBrush}" Width="12" Height="12" Stretch="Uniform" VerticalAlignment="Center" Opacity="0.6"/>
                                                            <TextBlock FontSize="12" Foreground="{DynamicResource TextMutedBrush}" Margin="5,0,0,0" VerticalAlignment="Center" Text="{Binding PageCount}"/>
                                                        </StackPanel>
                                                    </StackPanel>

                                                    <Path Grid.Column="2" Data="{StaticResource IconChevronRight}" Fill="{DynamicResource TextMutedBrush}"
                                                          Width="16" Height="16" Stretch="Uniform" VerticalAlignment="Center"/>
                                                </Grid>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <!-- Empty State -->
                                <StackPanel Visibility="{Binding HasRecentFiles, Converter={StaticResource BoolToVisibilityConverter}}" HorizontalAlignment="Center" Margin="0,48">
                                    <Path Data="{StaticResource IconPage}" Fill="{DynamicResource TextMutedBrush}" Width="48" Height="48" Stretch="Uniform"
                                          HorizontalAlignment="Center" Opacity="0.3"/>
                                    <TextBlock Text="暂无最近访问的文件" FontSize="15" FontWeight="Medium" Foreground="{DynamicResource TextSecondaryBrush}"
                                               HorizontalAlignment="Center" Margin="0,12,0,4"/>
                                    <TextBlock Text="打开一个 PDF 开始批注讲评" FontSize="13" Foreground="{DynamicResource TextMutedBrush}" HorizontalAlignment="Center"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </ContentControl>

            <!-- ─── TOOLBOX PAGE ─── -->
            <ContentControl Visibility="{Binding IsToolboxView, Converter={StaticResource BoolToVisibilityConverter}}">
                <ContentControl.Style>
                    <Style TargetType="ContentControl">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsToolboxView}" Value="True">
                                <DataTrigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.25" EasingFunction="{StaticResource EaseFluent}"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </DataTrigger.EnterActions>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </ContentControl.Style>
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="40,32" MaxWidth="960" HorizontalAlignment="Center">

                        <!-- Header -->
                        <StackPanel Margin="0,0,0,24">
                            <TextBlock Text="教学工具箱" FontSize="26" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                            <TextBlock Text="识别 PDF 中的文字内容，支持中文简体与英文" FontSize="14" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,4,0,0"/>
                        </StackPanel>

                        <!-- OCR Tool Section -->
                        <Border Background="{DynamicResource SurfaceRaisedBrush}" CornerRadius="{StaticResource RadiusLG}" Padding="24">
                            <Border.Effect>
                                <DropShadowEffect Color="#000000" BlurRadius="8" ShadowDepth="2" Opacity="0.06"/>
                            </Border.Effect>
                            <StackPanel>
                                <Grid Margin="0,0,0,18">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Width="44" Height="44" CornerRadius="{StaticResource RadiusMD}" Background="{StaticResource AccentSoftBrush}">
                                        <Path Data="{StaticResource IconPage}" Fill="{StaticResource AccentBrush}" Width="24" Height="24" Stretch="Uniform"
                                              HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center">
                                        <TextBlock Text="OCR 文字识别" FontSize="17" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                        <TextBlock Text="识别 PDF 中的文字内容（支持中英文）" FontSize="13" Foreground="{DynamicResource TextMutedBrush}" Margin="0,3,0,0"/>
                                    </StackPanel>
                                </Grid>

                                <Border Background="{DynamicResource SurfaceBaseBrush}" CornerRadius="{StaticResource RadiusSM}" Padding="14,10" Margin="0,0,0,16">
                                    <StackPanel>
                                        <TextBlock Text="当前文件" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                        <TextBlock Text="{Binding CurrentPdfPath, TargetNullValue='尚未打开 PDF，打开后可开始识别'}" FontSize="12" Foreground="{DynamicResource TextMutedBrush}"
                                                   TextTrimming="CharacterEllipsis" Margin="0,4,0,0"/>
                                    </StackPanel>
                                </Border>

                                <Button Style="{StaticResource BrowseButtonStyle}" Command="{Binding StartOcrCommand}" HorizontalAlignment="Left" Margin="0,0,0,16">
                                    <StackPanel Orientation="Horizontal">
                                        <Path Data="{StaticResource IconPage}" Fill="White" Width="18" Height="18" Stretch="Uniform" VerticalAlignment="Center"/>
                                        <TextBlock Text="开始识别" Foreground="White" Margin="8,0,0,0" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>

                                <StackPanel Visibility="{Binding IsOcrRunning, Converter={StaticResource BoolToVisibilityConverter}}" Margin="0,0,0,16">
                                    <TextBlock Text="{Binding OcrProgressText}" FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,8"/>
                                    <ProgressBar IsIndeterminate="True" Height="4"/>
                                </StackPanel>

                                <TextBlock Text="识别结果：" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,8"/>
                                <TextBox Text="{Binding OcrResult, Mode=OneWay}"
                                         IsReadOnly="True"
                                         TextWrapping="Wrap"
                                         AcceptsReturn="True"
                                         VerticalScrollBarVisibility="Auto"
                                         Height="320"
                                         Padding="12"
                                         FontFamily="Consolas"
                                         FontSize="12"
                                         Background="{DynamicResource SurfaceBaseBrush}"
                                         Foreground="{DynamicResource TextPrimaryBrush}"
                                         BorderBrush="{DynamicResource BorderSubtleBrush}"
                                         BorderThickness="1"
                                         Margin="0,0,0,12"/>

                                <StackPanel Orientation="Horizontal">
                                    <Button Style="{StaticResource SettingButtonStyle}" Command="{Binding CopyOcrResultCommand}" Margin="0,0,10,0">
                                        <TextBlock Text="复制结果" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                    </Button>
                                    <Button Style="{StaticResource SettingButtonStyle}" Command="{Binding GoBackCommand}">
                                        <TextBlock Text="返回" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                    </Button>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </ContentControl>

            <!-- ─── SETTINGS PAGE ─── -->
            <ContentControl Visibility="{Binding IsSettingsView, Converter={StaticResource BoolToVisibilityConverter}}">
                <ContentControl.Style>
                    <Style TargetType="ContentControl">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsSettingsView}" Value="True">
                                <DataTrigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.25" EasingFunction="{StaticResource EaseFluent}"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </DataTrigger.EnterActions>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </ContentControl.Style>
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="40,32" MaxWidth="760" HorizontalAlignment="Center">

                        <!-- Header -->
                        <StackPanel Margin="0,0,0,24">
                            <TextBlock Text="设置" FontSize="26" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                            <TextBlock Text="调整应用偏好与存储选项" FontSize="14" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,4,0,0"/>
                        </StackPanel>

                        <!-- Settings List -->
                        <Border Background="{DynamicResource SurfaceRaisedBrush}" CornerRadius="{StaticResource RadiusLG}">
                            <Border.Effect>
                                <DropShadowEffect Color="#000000" BlurRadius="8" ShadowDepth="2" Opacity="0.06"/>
                            </Border.Effect>
                            <StackPanel>
                                <!-- 深色模式 -->
                                <Border BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="0,0,0,1" Padding="24,20">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                            <TextBlock Text="深色模式" FontSize="15" FontWeight="Medium" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                            <TextBlock Text="暗光教室下降低对师生视力的刺激" FontSize="13" Foreground="{DynamicResource TextMutedBrush}" Margin="0,2,0,0"/>
                                        </StackPanel>
                                        <ToggleButton Grid.Column="1" Style="{StaticResource ToggleSwitchStyle}" IsChecked="{Binding IsDarkMode}"/>
                                    </Grid>
                                </Border>

                                <!-- 自动保存 -->
                                <Border BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="0,0,0,1" Padding="24,20">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                            <TextBlock Text="自动保存" FontSize="15" FontWeight="Medium" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                            <TextBlock Text="关闭文件时自动保存批注，无需手动保存" FontSize="13" Foreground="{DynamicResource TextMutedBrush}" Margin="0,2,0,0"/>
                                        </StackPanel>
                                        <ToggleButton Grid.Column="1" Style="{StaticResource ToggleSwitchStyle}" IsChecked="{Binding Settings.AutoSaveAnnotations}"/>
                                    </Grid>
                                </Border>

                                <!-- 最近文件数量 -->
                                <Border BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="0,0,0,1" Padding="24,20">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                            <TextBlock Text="最近文件数量" FontSize="15" FontWeight="Medium" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                            <TextBlock FontSize="13" Foreground="{DynamicResource TextMutedBrush}" Margin="0,2,0,0">
                                                <Run Text="保存"/><Run Text=" "/><Run Text="{Binding Settings.MaxRecentFiles, Mode=OneWay}"/><Run Text=" "/><Run Text="个最近文件"/>
                                            </TextBlock>
                                        </StackPanel>
                                        <Slider Grid.Column="1" Width="200" Minimum="5" Maximum="20" TickFrequency="1" IsSnapToTickEnabled="True"
                                                Value="{Binding Settings.MaxRecentFiles}" VerticalAlignment="Center"/>
                                    </Grid>
                                </Border>

                                <!-- 默认画笔粗细 -->
                                <Border BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="0,0,0,1" Padding="24,20">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                            <TextBlock Text="默认画笔粗细" FontSize="15" FontWeight="Medium" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                            <TextBlock FontSize="13" Foreground="{DynamicResource TextMutedBrush}" Margin="0,2,0,0">
                                                <Run Text="当前值:"/><Run Text=" "/><Run Text="{Binding Settings.DefaultPenSize, Mode=OneWay}"/>
                                            </TextBlock>
                                        </StackPanel>
                                        <Slider Grid.Column="1" Width="200" Minimum="1" Maximum="20" TickFrequency="1" IsSnapToTickEnabled="True"
                                                Value="{Binding Settings.DefaultPenSize}" VerticalAlignment="Center"/>
                                    </Grid>
                                </Border>

                                <!-- 清空最近访问 -->
                                <Border Padding="24,20">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                            <TextBlock Text="清空最近访问" FontSize="15" FontWeight="Medium" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                            <TextBlock Text="删除所有最近访问记录" FontSize="13" Foreground="{DynamicResource TextMutedBrush}" Margin="0,2,0,0"/>
                                        </StackPanel>
                                        <Button Grid.Column="1" Style="{StaticResource SettingButtonStyle}" Click="ClearRecent_Click">
                                            <TextBlock Text="清空" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                        </Button>
                                    </Grid>
                                </Border>
                            </StackPanel>
                        </Border>

                        <!-- Action Buttons -->
                        <StackPanel Orientation="Horizontal" Margin="0,24,0,0">
                            <Button Style="{StaticResource BrowseButtonStyle}" Click="SaveSettings_Click">
                                <TextBlock Text="保存设置"/>
                            </Button>
                            <Button Style="{StaticResource SettingButtonStyle}" Command="{Binding GoBackCommand}" Margin="12,0,0,0">
                                <TextBlock Text="返回" Foreground="{DynamicResource TextPrimaryBrush}"/>
                            </Button>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </ContentControl>

            <!-- ─── ABOUT PAGE ─── -->
            <ContentControl Visibility="{Binding IsAboutView, Converter={StaticResource BoolToVisibilityConverter}}">
                <ContentControl.Style>
                    <Style TargetType="ContentControl">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsAboutView}" Value="True">
                                <DataTrigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.25" EasingFunction="{StaticResource EaseFluent}"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </DataTrigger.EnterActions>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </ContentControl.Style>
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="40,32" MaxWidth="760" HorizontalAlignment="Center">

                        <!-- Header -->
                        <StackPanel Margin="0,0,0,24">
                            <TextBlock Text="关于 PdfTeachAnnotator" FontSize="26" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                            <TextBlock Text="现代化教学批注系统" FontSize="14" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,4,0,0"/>
                        </StackPanel>

                        <!-- About Content -->
                        <Border Background="{DynamicResource SurfaceRaisedBrush}" CornerRadius="{StaticResource RadiusLG}">
                            <Border.Effect>
                                <DropShadowEffect Color="#000000" BlurRadius="8" ShadowDepth="2" Opacity="0.06"/>
                            </Border.Effect>
                            <StackPanel>
                                <!-- Hero -->
                                <StackPanel HorizontalAlignment="Center" Margin="0,40,0,24">
                                    <Border Width="64" Height="64" CornerRadius="18" Background="{StaticResource AccentBrush}">
                                        <TextBlock Text="E" Foreground="White" FontWeight="Bold" FontSize="28"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <TextBlock Text="EduPDF 教学批注系统" FontSize="22" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}"
                                               HorizontalAlignment="Center" Margin="0,16,0,0"/>
                                    <TextBlock Text="版本 1.0.0" FontSize="13" Foreground="{DynamicResource TextMutedBrush}" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                                </StackPanel>

                                <!-- Description -->
                                <TextBlock TextAlignment="Center" TextWrapping="Wrap" MaxWidth="600" Margin="0,0,0,24"
                                           FontSize="14" Foreground="{DynamicResource TextSecondaryBrush}" LineHeight="24">
                                    专为中小学及高校教学场景设计的现代化 PDF 批注软件。支持原笔迹手写、多种教学画笔工具与防丢失的自动保存功能，完美适配多媒体教学一体机的大屏触控操作。
                                </TextBlock>

                                <!-- Features -->
                                <Border BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="0,1,0,0" Padding="32,24">
                                    <StackPanel>
                                        <TextBlock Text="核心特性" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,12"/>
                                        <UniformGrid Columns="2" Rows="3">
                                            <Border Background="{DynamicResource SurfaceBaseBrush}" CornerRadius="{StaticResource RadiusSM}" Padding="28,8,12,8" Margin="0,0,6,5">
                                                <TextBlock Text="原笔迹手写批注阻尼感" FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                            </Border>
                                            <Border Background="{DynamicResource SurfaceBaseBrush}" CornerRadius="{StaticResource RadiusSM}" Padding="28,8,12,8" Margin="6,0,0,5">
                                                <TextBlock Text="钢笔、荧光、激光、橡皮擦" FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                            </Border>
                                            <Border Background="{DynamicResource SurfaceBaseBrush}" CornerRadius="{StaticResource RadiusSM}" Padding="28,8,12,8" Margin="0,0,6,5">
                                                <TextBlock Text="智能OCR识别" FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                            </Border>
                                            <Border Background="{DynamicResource SurfaceBaseBrush}" CornerRadius="{StaticResource RadiusSM}" Padding="28,8,12,8" Margin="6,0,0,5">
                                                <TextBlock Text="无感异步自动保存" FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                            </Border>
                                            <Border Background="{DynamicResource SurfaceBaseBrush}" CornerRadius="{StaticResource RadiusSM}" Padding="28,8,12,8" Margin="0,0,6,0">
                                                <TextBlock Text="深色模式适配暗光教室" FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                            </Border>
                                            <Border Background="{DynamicResource SurfaceBaseBrush}" CornerRadius="{StaticResource RadiusSM}" Padding="28,8,12,8" Margin="6,0,0,0">
                                                <TextBlock Text="Windows 11 Fluent 风格" FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                            </Border>
                                        </UniformGrid>
                                    </StackPanel>
                                </Border>

                                <!-- Footer -->
                                <Border BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="0,1,0,0" Padding="32,24">
                                    <TextBlock Text="© 2026 EduPDF Team · 保留所有权利" FontSize="13" Foreground="{DynamicResource TextMutedBrush}" HorizontalAlignment="Center"/>
                                </Border>
                            </StackPanel>
                        </Border>

                        <Button Style="{StaticResource SettingButtonStyle}" Command="{Binding GoBackCommand}" Margin="0,24,0,0" HorizontalAlignment="Left">
                            <TextBlock Text="返回" Foreground="{DynamicResource TextPrimaryBrush}"/>
                        </Button>
                    </StackPanel>
                </ScrollViewer>
            </ContentControl>

            <!-- ─── PDF EDITOR VIEW (按 App.jsx EditorOverlay) ─── -->
            <Grid Visibility="{Binding IsPdfView, Converter={StaticResource BoolToVisibilityConverter}}">
                <Grid.Style>
                    <Style TargetType="Grid">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsPdfView}" Value="True">
                                <DataTrigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.25" EasingFunction="{StaticResource EaseFluent}"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </DataTrigger.EnterActions>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Editor Top Bar (jsx: editor-topbar) -->
                <Border Grid.Row="0" Background="{DynamicResource SurfaceRaisedBrush}"
                        BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="0,0,0,1" Padding="8,8"
                        Effect="{StaticResource ShadowSM}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- File Info -->
                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                            <Path Data="{StaticResource IconPage}" Fill="#EF4444" Width="20" Height="20" Stretch="Uniform"/>
                            <TextBlock Text="{Binding CurrentPdfPath}" FontSize="14" FontWeight="Medium" Foreground="{DynamicResource TextPrimaryBrush}"
                                       Margin="10,0,0,0" TextTrimming="CharacterEllipsis" MaxWidth="240" VerticalAlignment="Center"/>
                        </StackPanel>

                        <!-- Center: Undo/Redo + Tools + Zoom + Page Count -->
                        <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Border x:Name="ToolButtonsBorder" Background="{DynamicResource SurfaceBaseBrush}"
                                    BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="{StaticResource RadiusMD}" Padding="4">
                                <StackPanel Orientation="Horizontal">
                                    <!-- 撤销/重做 -->
                                    <Button Style="{StaticResource ToolbarIconButtonStyle}" Command="{Binding UndoCommand}" ToolTip="撤销 (Ctrl+Z)">
                                        <Path Data="{StaticResource IconUndo}" Fill="{DynamicResource TextPrimaryBrush}" Width="18" Height="18" Stretch="Uniform"/>
                                    </Button>
                                    <Button Style="{StaticResource ToolbarIconButtonStyle}" Command="{Binding RedoCommand}" ToolTip="重做 (Ctrl+Y)">
                                        <Path Data="{StaticResource IconRedo}" Fill="{DynamicResource TextPrimaryBrush}" Width="18" Height="18" Stretch="Uniform"/>
                                    </Button>
                                    <Border Width="1" Height="24" Background="{DynamicResource BorderSubtleBrush}" Margin="4,0" VerticalAlignment="Center"/>
                                    <!-- 工具按钮 -->
                                    <ToggleButton x:Name="PenBtn" Style="{StaticResource EditorToolButtonStyle}" ToolTip="钢笔"
                                                  IsChecked="{Binding Toolbar.IsPenActive, Mode=OneWay}" Command="{Binding Toolbar.SelectPenCommand}">
                                        <StackPanel Orientation="Horizontal">
                                            <Path Data="{StaticResource IconPen}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}" Width="20" Height="20" Stretch="Uniform" VerticalAlignment="Center"/>
                                            <TextBlock Text="钢笔" Margin="6,0,0,0" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </ToggleButton>
                                    <ToggleButton x:Name="HighlighterBtn" Style="{StaticResource EditorToolButtonStyle}" ToolTip="荧光笔"
                                                  IsChecked="{Binding Toolbar.IsHighlighterActive, Mode=OneWay}" Command="{Binding Toolbar.SelectHighlighterCommand}">
                                        <StackPanel Orientation="Horizontal">
                                            <Path Data="{StaticResource IconHighlighter}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}" Width="20" Height="20" Stretch="Uniform" VerticalAlignment="Center"/>
                                            <TextBlock Text="荧光" Margin="6,0,0,0" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </ToggleButton>
                                    <ToggleButton x:Name="LaserBtn" Style="{StaticResource EditorToolButtonStyle}" ToolTip="激光笔"
                                                  IsChecked="{Binding Toolbar.IsLaserActive, Mode=OneWay}" Command="{Binding Toolbar.SelectLaserCommand}">
                                        <StackPanel Orientation="Horizontal">
                                            <Path Data="{StaticResource IconLaser}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}" Width="20" Height="20" Stretch="Uniform" VerticalAlignment="Center"/>
                                            <TextBlock Text="激光" Margin="6,0,0,0" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </ToggleButton>
                                    <ToggleButton x:Name="EraserBtn" Style="{StaticResource EditorToolButtonStyle}" ToolTip="橡皮擦"
                                                  IsChecked="{Binding Toolbar.IsEraserActive, Mode=OneWay}" Command="{Binding Toolbar.SelectEraserCommand}">
                                        <StackPanel Orientation="Horizontal">
                                            <Path Data="{StaticResource IconEraser}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}" Width="20" Height="20" Stretch="Uniform" VerticalAlignment="Center"/>
                                            <TextBlock Text="橡皮" Margin="6,0,0,0" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </ToggleButton>
                                    <Border Width="1" Height="24" Background="{DynamicResource BorderSubtleBrush}" Margin="4,0" VerticalAlignment="Center"/>
                                    <!-- 缩放 -->
                                    <Button Style="{StaticResource ToolbarIconButtonStyle}" Command="{Binding ZoomOutCommand}" ToolTip="缩小">
                                        <Path Data="{StaticResource IconZoomOut}" Fill="{DynamicResource TextPrimaryBrush}" Width="18" Height="18" Stretch="Uniform"/>
                                    </Button>
                                    <TextBlock Text="{Binding ZoomPercent}" VerticalAlignment="Center" Margin="4,0" MinWidth="40" TextAlignment="Center"
                                               Foreground="{DynamicResource TextPrimaryBrush}" FontWeight="Bold" FontSize="13"/>
                                    <Button Style="{StaticResource ToolbarIconButtonStyle}" Command="{Binding ZoomInCommand}" ToolTip="放大">
                                        <Path Data="{StaticResource IconZoomIn}" Fill="{DynamicResource TextPrimaryBrush}" Width="18" Height="18" Stretch="Uniform"/>
                                    </Button>
                                </StackPanel>
                            </Border>

                            <Border Margin="8,0,0,0"
                                    Background="{DynamicResource SurfaceBaseBrush}" CornerRadius="18"
                                    BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1"
                                    Padding="12,6" VerticalAlignment="Center">
                                <TextBlock Text="{Binding PageIndicatorText}"
                                           FontSize="12" Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center"/>
                            </Border>
                        </StackPanel>

                        <!-- Tool Property Popup (jsx: editor-tool-popup) -->
                        <Popup x:Name="ToolPopup" IsOpen="{Binding Toolbar.ShowToolPopup}"
                               Placement="Bottom"
                               StaysOpen="True"
                               AllowsTransparency="True"
                               PopupAnimation="Slide"
                               VerticalOffset="6">
                            <Border Background="{DynamicResource SurfaceRaisedBrush}"
                                    BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1"
                                    CornerRadius="{StaticResource RadiusMD}"
                                    Effect="{StaticResource ShadowLG}"
                                    Padding="14,12"
                                    MinWidth="260">
                                <StackPanel>
                                    <!-- 颜色区 (橡皮擦时隐藏) -->
                                    <StackPanel Visibility="{Binding Toolbar.IsEraserActive, Converter={StaticResource InverseBoolToVisibilityConverter}}">
                                        <TextBlock Text="颜色" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,8"/>
                                        <ItemsControl ItemsSource="{Binding Toolbar.PenColors}" Tag="{Binding Toolbar}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <WrapPanel/>
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Button Command="{Binding Tag.SetPenColorCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                            CommandParameter="{Binding}"
                                                            Width="28" Height="28" Margin="3"
                                                            Cursor="Hand" Background="{Binding Converter={StaticResource ColorToBrushConverter}}"
                                                            BorderThickness="0" ToolTip="选择颜色">
                                                        <Button.Style>
                                                            <Style TargetType="Button">
                                                                <Setter Property="Template">
                                                                    <Setter.Value>
                                                                        <ControlTemplate TargetType="Button">
                                                                            <Border x:Name="Swatch" Background="{TemplateBinding Background}" CornerRadius="6"
                                                                                    Width="28" Height="28" RenderTransformOrigin="0.5,0.5">
                                                                                <Border.RenderTransform><ScaleTransform ScaleX="1" ScaleY="1"/></Border.RenderTransform>
                                                                            </Border>
                                                                            <ControlTemplate.Triggers>
                                                                                <Trigger Property="IsMouseOver" Value="True">
                                                                                    <Setter TargetName="Swatch" Property="RenderTransform">
                                                                                        <Setter.Value><ScaleTransform ScaleX="1.15" ScaleY="1.15"/></Setter.Value>
                                                                                    </Setter>
                                                                                </Trigger>
                                                                            </ControlTemplate.Triggers>
                                                                        </ControlTemplate>
                                                                    </Setter.Value>
                                                                </Setter>
                                                            </Style>
                                                        </Button.Style>
                                                    </Button>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        <Border Height="1" Background="{DynamicResource BorderSubtleBrush}" Margin="0,12,0,10"/>
                                    </StackPanel>

                                    <!-- 粗细区（钢笔/激光） -->
                                    <StackPanel Visibility="{Binding Toolbar.IsPenActive, Converter={StaticResource BoolToVisibilityConverter}}">
                                        <TextBlock Text="粗细" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,8"/>
                                        <ItemsControl ItemsSource="{Binding Toolbar.PenSizes}" Tag="{Binding Toolbar}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Button Command="{Binding Tag.SetPenSizeCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                            CommandParameter="{Binding}" Style="{StaticResource PopupSizeButtonStyle}" Margin="3,0" VerticalAlignment="Center">
                                                        <Button.BorderBrush>
                                                            <MultiBinding Converter="{StaticResource SizeSelectedBrushConverter}">
                                                                <Binding Path="Tag.PenSize" RelativeSource="{RelativeSource AncestorType=ItemsControl}"/>
                                                                <Binding/>
                                                            </MultiBinding>
                                                        </Button.BorderBrush>
                                                        <StackPanel HorizontalAlignment="Center">
                                                            <Ellipse Width="{Binding Converter={StaticResource EraserSizeConverter}}" Height="{Binding Converter={StaticResource EraserSizeConverter}}"
                                                                     Fill="{DynamicResource TextPrimaryBrush}" HorizontalAlignment="Center" Margin="0,0,0,4"/>
                                                            <TextBlock Text="{Binding}" FontSize="10" Foreground="{DynamicResource TextMutedBrush}" HorizontalAlignment="Center"/>
                                                        </StackPanel>
                                                    </Button>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>

                                    <!-- 粗细区（荧光笔） -->
                                    <StackPanel Visibility="{Binding Toolbar.IsHighlighterActive, Converter={StaticResource BoolToVisibilityConverter}}">
                                        <TextBlock Text="粗细" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,8"/>
                                        <ItemsControl ItemsSource="{Binding Toolbar.HighlighterSizes}" Tag="{Binding Toolbar}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Button Command="{Binding Tag.SetPenSizeCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                            CommandParameter="{Binding}" Style="{StaticResource PopupSizeButtonStyle}" Margin="3,0" VerticalAlignment="Center">
                                                        <Button.BorderBrush>
                                                            <MultiBinding Converter="{StaticResource SizeSelectedBrushConverter}">
                                                                <Binding Path="Tag.PenSize" RelativeSource="{RelativeSource AncestorType=ItemsControl}"/>
                                                                <Binding/>
                                                            </MultiBinding>
                                                        </Button.BorderBrush>
                                                        <StackPanel HorizontalAlignment="Center">
                                                            <Ellipse Width="{Binding Converter={StaticResource EraserSizeConverter}}" Height="{Binding Converter={StaticResource EraserSizeConverter}}"
                                                                     Fill="{DynamicResource TextPrimaryBrush}" HorizontalAlignment="Center" Margin="0,0,0,4"/>
                                                            <TextBlock Text="{Binding}" FontSize="10" Foreground="{DynamicResource TextMutedBrush}" HorizontalAlignment="Center"/>
                                                        </StackPanel>
                                                    </Button>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>

                                    <!-- 粗细区（橡皮擦） -->
                                    <StackPanel Visibility="{Binding Toolbar.IsEraserActive, Converter={StaticResource BoolToVisibilityConverter}}">
                                        <TextBlock Text="大小" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,8"/>
                                        <ItemsControl ItemsSource="{Binding Toolbar.EraserSizes}" Tag="{Binding Toolbar}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Button Command="{Binding Tag.SetEraserSizeCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                            CommandParameter="{Binding}" Style="{StaticResource PopupSizeButtonStyle}" Margin="3,0" VerticalAlignment="Center">
                                                        <Button.BorderBrush>
                                                            <MultiBinding Converter="{StaticResource SizeSelectedBrushConverter}">
                                                                <Binding Path="Tag.EraserSize" RelativeSource="{RelativeSource AncestorType=ItemsControl}"/>
                                                                <Binding/>
                                                            </MultiBinding>
                                                        </Button.BorderBrush>
                                                        <StackPanel HorizontalAlignment="Center">
                                                            <Ellipse Width="{Binding Converter={StaticResource EraserSizeConverter}}" Height="{Binding Converter={StaticResource EraserSizeConverter}}"
                                                                     Fill="{DynamicResource TextMutedBrush}" HorizontalAlignment="Center" Margin="0,0,0,4"/>
                                                            <TextBlock Text="{Binding}" FontSize="10" Foreground="{DynamicResource TextMutedBrush}" HorizontalAlignment="Center"/>
                                                        </StackPanel>
                                                    </Button>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </Popup>

                        <!-- Right: AutoSave + Close -->
                        <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <Border Background="{DynamicResource SurfaceRaisedBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1"
                                    CornerRadius="20" Padding="14,8">
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse Width="8" Height="8" Fill="{StaticResource SuccessBrush}" VerticalAlignment="Center"/>
                                    <TextBlock Text="自动保存就绪" FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}" Margin="8,0,0,0" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Border>
                            <Button Style="{StaticResource EditorCloseButtonStyle}" Command="{Binding ShowHomeCommand}" ToolTip="关闭" Margin="12,0,0,0">
                                <Path Data="{StaticResource IconClose}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Width="20" Height="20" Stretch="Uniform"/>
                            </Button>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- PDF Canvas (jsx: editor-canvas) -->
                <Grid Grid.Row="1">
                    <ListBox x:Name="PagesControl"
                             ItemsSource="{Binding Pages}"
                             Background="{DynamicResource SurfaceBaseBrush}"
                             BorderThickness="0"
                             Loaded="PagesControl_Loaded"
                             PreviewMouseWheel="ScrollViewer_PreviewMouseWheel"
                             SizeChanged="ScrollViewer_SizeChanged"
                             ScrollViewer.HorizontalScrollBarVisibility="Auto"
                             ScrollViewer.VerticalScrollBarVisibility="Auto"
                             ScrollViewer.CanContentScroll="True"
                             VirtualizingPanel.IsVirtualizing="True"
                             VirtualizingPanel.VirtualizationMode="Recycling"
                             VirtualizingPanel.CacheLength="2"
                             VirtualizingPanel.CacheLengthUnit="Item"
                             VirtualizingPanel.ScrollUnit="Pixel">
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <VirtualizingStackPanel Orientation="Vertical"/>
                        </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="HorizontalContentAlignment" Value="Center"/>
                            <Setter Property="Padding" Value="0"/>
                            <Setter Property="Margin" Value="0"/>
                            <Setter Property="Focusable" Value="False"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <ContentPresenter/>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border Margin="0,10" HorizontalAlignment="Center" Background="White"
                                    BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="4">
                                <Border.LayoutTransform>
                                    <ScaleTransform ScaleX="{Binding DataContext.ZoomLevel, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    ScaleY="{Binding DataContext.ZoomLevel, RelativeSource={RelativeSource AncestorType=Window}}"/>
                                </Border.LayoutTransform>
                                <Border.Effect>
                                    <DropShadowEffect Color="#000000" BlurRadius="12" ShadowDepth="3" Opacity="0.15"/>
                                </Border.Effect>
                                <Grid HorizontalAlignment="Center" Width="{Binding PageWidth}" Height="{Binding PageHeight}">
                                    <Image Source="{Binding Image}" Width="{Binding PageWidth}" Height="{Binding PageHeight}" Stretch="None"/>
                                    <InkCanvas Strokes="{Binding Strokes}" Width="{Binding PageWidth}" Height="{Binding PageHeight}"
                                               Background="Transparent" Loaded="InkCanvas_Loaded"
                                               StrokeCollected="InkCanvas_StrokeCollected" StrokeErased="InkCanvas_StrokeErased"
                                               EditingMode="{Binding DataContext.Toolbar.ActiveTool, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource ToolModeConverter}}"
                                               DefaultDrawingAttributes="{Binding DataContext.Toolbar.DrawingAttributes, RelativeSource={RelativeSource AncestorType=Window}}"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                </Grid>
            </Grid>

        </Grid>
    </Grid>
</Window>