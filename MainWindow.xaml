<Window x:Class="PdfTeachAnnotator.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:PdfTeachAnnotator.Converters"
        Title="PdfTeachAnnotator" Height="700" Width="1000"
        WindowState="Maximized"
        Background="{DynamicResource SurfaceBaseBrush}"
        Icon="pack://application:,,,/app.ico"
        AllowDrop="True" Drop="Window_Drop" DragOver="Window_DragOver"
        PreviewMouseDown="Window_PreviewMouseDown">
    <Window.Resources>
        <local:ColorToBrushConverter x:Key="ColorToBrushConverter"/>
        <local:ToolModeToEditingModeConverter x:Key="ToolModeConverter"/>
        <local:BoolToFontWeightConverter x:Key="BoolToFontWeight"/>
        <local:ColorSelectedConverter x:Key="ColorSelectedConverter"/>
        <local:PenIconColorConverter x:Key="PenIconColorConverter"/>
        <local:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
        <local:InverseBoolToVisibilityConverter x:Key="InverseBoolToVisibilityConverter"/>
        <local:SliderProgressConverter x:Key="SliderProgressConverter"/>
        <local:EraserSizeConverter x:Key="EraserSizeConverter"/>
        <local:SizeEqualityConverter x:Key="SizeEqualityConverter"/>
        <local:InvertBoolConverter x:Key="InvertBoolConverter"/>
        <local:SizeSelectedBrushConverter x:Key="SizeSelectedBrushConverter"/>
        <local:BoolToGridLengthConverter x:Key="BoolToGridLengthConverter"/>

        <!-- Material-style vector icon geometries -->
