                    <Path Data="{StaticResource IconSave}" Fill="#27AE60" Width="20" Height="20" Stretch="Uniform"/>
                </Button>
                <Separator Margin="8,0"/>
                <Button Style="{StaticResource IconButtonStyle}" Command="{Binding UndoCommand}" ToolTip="撤消 (Ctrl+Z)">
                    <Path Data="{StaticResource IconUndo}" Fill="#5D6D7E" Width="20" Height="20" Stretch="Uniform"/>
                </Button>
                <Button Style="{StaticResource IconButtonStyle}" Command="{Binding RedoCommand}" ToolTip="重做 (Ctrl+Y)">
                    <Path Data="{StaticResource IconRedo}" Fill="#5D6D7E" Width="20" Height="20" Stretch="Uniform"/>
                </Button>
                <Separator Margin="8,0"/>
                <ToggleButton Style="{StaticResource IconToggleButtonStyle}"
                              IsChecked="{Binding Toolbar.IsPenActive, Mode=OneWay}"
                              Command="{Binding Toolbar.SelectPenCommand}" ToolTip="画笔">
                    <Path Data="{StaticResource IconPen}" Width="20" Height="20" Stretch="Uniform">
                        <Path.Fill>
                            <MultiBinding Converter="{StaticResource PenIconColorConverter}">
                                <Binding Path="Toolbar.IsPenActive"/>
                                <Binding Path="Toolbar.SelectedColor"/>
                            </MultiBinding>
                        </Path.Fill>
                    </Path>
                </ToggleButton>
                <ToggleButton Style="{StaticResource IconToggleButtonStyle}"
                              IsChecked="{Binding Toolbar.IsEraserActive, Mode=OneWay}"
                              Command="{Binding Toolbar.SelectEraserCommand}" ToolTip="橡皮">
                    <Path Data="{StaticResource IconEraser}" Width="20" Height="20" Stretch="Uniform">
                        <Path.Style>
                            <Style TargetType="Path">
                                <Setter Property="Fill" Value="#95A5A6"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Toolbar.IsEraserActive}" Value="True">
                                        <Setter Property="Fill" Value="White"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Path.Style>
                    </Path>
                </ToggleButton>
                <Button Style="{StaticResource IconButtonStyle}" Command="{Binding Toolbar.ClearAllCommand}" ToolTip="清空所有批注">
                    <Path Data="{StaticResource IconClear}" Fill="#E74C3C" Width="20" Height="20" Stretch="Uniform"/>
                </Button>
                <Separator Margin="8,0"/>
                <!-- Color Palette -->
                <TextBlock Text="颜色" VerticalAlignment="Center" Margin="8,0,8,0" Foreground="#34495E" FontWeight="SemiBold" FontSize="13"/>
                <ItemsControl ItemsSource="{Binding Toolbar.PenColors}" Margin="4,0">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Width="28" Height="28" Margin="3" BorderThickness="3" Cursor="Hand" CornerRadius="14"
                                    Background="{Binding Converter={StaticResource ColorToBrushConverter}}"
                                    MouseLeftButtonDown="ColorSwatch_Click" Tag="{Binding}">
                                <Border.Effect>
                                    <DropShadowEffect Color="#000000" BlurRadius="4" ShadowDepth="1" Opacity="0.2"/>
                                </Border.Effect>
                                <Border.BorderBrush>
                                    <MultiBinding Converter="{StaticResource ColorSelectedConverter}">
                                        <Binding/>
                                        <Binding Path="DataContext.Toolbar.SelectedColor" RelativeSource="{RelativeSource AncestorType=Window}"/>
                                    </MultiBinding>
                                </Border.BorderBrush>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <Separator Margin="8,0"/>
                <!-- Pen Size -->
                <TextBlock Text="笔粗" VerticalAlignment="Center" Margin="8,0,6,0" Foreground="{DynamicResource TextFillColorPrimaryBrush}" FontWeight="SemiBold" FontSize="13"/>
                <ItemsControl ItemsSource="{Binding Toolbar.PenSizes}" VerticalAlignment="Center">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Command="{Binding DataContext.Toolbar.SetPenSizeCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                    CommandParameter="{Binding}"
                                    Width="32" Height="32" Margin="2,0" Cursor="Hand"
                                    Background="Transparent" BorderThickness="0">
                                <Grid>
                                    <Ellipse Width="{Binding}" Height="{Binding}"
                                             Fill="#3498DB" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    <Ellipse Width="{Binding}" Height="{Binding}"
                                             Stroke="#2980B9" StrokeThickness="2"
                                             HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <Ellipse.Visibility>
                                            <MultiBinding Converter="{StaticResource SizeEqualityConverter}">
                                                <Binding Path="DataContext.Toolbar.PenSize" RelativeSource="{RelativeSource AncestorType=Window}"/>
                                                <Binding/>
                                            </MultiBinding>
                                        </Ellipse.Visibility>
                                    </Ellipse>
                                </Grid>
                                <Button.Style>
                                    <Style TargetType="Button">
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="Button">
                                                    <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                                            BorderBrush="{TemplateBinding BorderBrush}"
                                                            BorderThickness="{TemplateBinding BorderThickness}"
                                                            RenderTransformOrigin="0.5,0.5">
                                                        <Border.RenderTransform>
                                                            <ScaleTransform ScaleX="1" ScaleY="1"/>
                                                        </Border.RenderTransform>
                                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="Bd" Property="Opacity" Value="0.8"/>
                                                        </Trigger>
                                                        <Trigger Property="IsPressed" Value="True">
                                                            <Trigger.EnterActions>
                                                                <BeginStoryboard>
                                                                    <Storyboard>
                                                                        <DoubleAnimation Storyboard.TargetName="Bd" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" To="0.8" Duration="0:0:0.08"/>
                                                                        <DoubleAnimation Storyboard.TargetName="Bd" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" To="0.8" Duration="0:0:0.08"/>
                                                                    </Storyboard>
                                                                </BeginStoryboard>
                                                            </Trigger.EnterActions>
                                                            <Trigger.ExitActions>
                                                                <BeginStoryboard>
                                                                    <Storyboard>
                                                                        <DoubleAnimation Storyboard.TargetName="Bd" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" To="1" Duration="0:0:0.12"/>
                                                                        <DoubleAnimation Storyboard.TargetName="Bd" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" To="1" Duration="0:0:0.12"/>
                                                                    </Storyboard>
                                                                </BeginStoryboard>
                                                            </Trigger.ExitActions>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </Button.Style>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <Separator Margin="8,0"/>
                <!-- Eraser Size -->
                <TextBlock Text="擦头" VerticalAlignment="Center" Margin="8,0,6,0" Foreground="{DynamicResource TextFillColorPrimaryBrush}" FontWeight="SemiBold" FontSize="13"/>
                <ItemsControl ItemsSource="{Binding Toolbar.EraserSizes}" VerticalAlignment="Center">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Command="{Binding DataContext.Toolbar.SetEraserSizeCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                    CommandParameter="{Binding}"
                                    Width="40" Height="40" Margin="2,0" Cursor="Hand"
                                    Background="Transparent" BorderThickness="0">
                                <Grid>
                                    <Ellipse Width="{Binding Converter={StaticResource EraserSizeConverter}}"
                                             Height="{Binding Converter={StaticResource EraserSizeConverter}}"
                                             Fill="#95A5A6" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    <Ellipse Width="{Binding Converter={StaticResource EraserSizeConverter}}"
                                             Height="{Binding Converter={StaticResource EraserSizeConverter}}"
                                             Stroke="#7F8C8D" StrokeThickness="2"
                                             HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <Ellipse.Visibility>
                                            <MultiBinding Converter="{StaticResource SizeEqualityConverter}">
                                                <Binding Path="DataContext.Toolbar.EraserSize" RelativeSource="{RelativeSource AncestorType=Window}"/>
                                                <Binding/>
                                            </MultiBinding>
                                        </Ellipse.Visibility>
                                    </Ellipse>
                                </Grid>
                                <Button.Style>
                                    <Style TargetType="Button">
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="Button">
                                                    <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                                            BorderBrush="{TemplateBinding BorderBrush}"
                                                            BorderThickness="{TemplateBinding BorderThickness}"
                                                            RenderTransformOrigin="0.5,0.5">
                                                        <Border.RenderTransform>
                                                            <ScaleTransform ScaleX="1" ScaleY="1"/>
                                                        </Border.RenderTransform>
                                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="Bd" Property="Opacity" Value="0.8"/>
                                                        </Trigger>
                                                        <Trigger Property="IsPressed" Value="True">
                                                            <Trigger.EnterActions>
                                                                <BeginStoryboard>
                                                                    <Storyboard>
                                                                        <DoubleAnimation Storyboard.TargetName="Bd" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" To="0.8" Duration="0:0:0.08"/>
                                                                        <DoubleAnimation Storyboard.TargetName="Bd" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" To="0.8" Duration="0:0:0.08"/>
                                                                    </Storyboard>
                                                                </BeginStoryboard>
                                                            </Trigger.EnterActions>
                                                            <Trigger.ExitActions>
                                                                <BeginStoryboard>
                                                                    <Storyboard>
                                                                        <DoubleAnimation Storyboard.TargetName="Bd" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" To="1" Duration="0:0:0.12"/>
                                                                        <DoubleAnimation Storyboard.TargetName="Bd" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" To="1" Duration="0:0:0.12"/>
                                                                    </Storyboard>
                                                                </BeginStoryboard>
                                                            </Trigger.ExitActions>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </Button.Style>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <Separator Margin="8,0"/>
                <!-- Zoom -->
                <Button Style="{StaticResource IconButtonStyle}" Command="{Binding ZoomOutCommand}" ToolTip="缩小">
                    <Path Data="{StaticResource IconZoomOut}" Fill="#7F8C8D" Width="20" Height="20" Stretch="Uniform"/>
                </Button>
                <TextBlock Text="{Binding ZoomPercent}" VerticalAlignment="Center" Margin="8,0" MinWidth="50"
                           TextAlignment="Center" Foreground="#2C3E50" FontWeight="Bold" FontSize="14"/>
                <Button Style="{StaticResource IconButtonStyle}" Command="{Binding ZoomInCommand}" ToolTip="放大">
                    <Path Data="{StaticResource IconZoomIn}" Fill="#7F8C8D" Width="20" Height="20" Stretch="Uniform"/>
                </Button>
                <Button Style="{StaticResource IconButtonStyle}" Command="{Binding ZoomResetCommand}" ToolTip="重置缩放">
                    <Path Data="{StaticResource IconZoomReset}" Fill="#7F8C8D" Width="20" Height="20" Stretch="Uniform"/>
                </Button>
            </ToolBar>
        </ToolBarTray>

        <!-- Clear Slider Panel -->
        <Border DockPanel.Dock="Top" Background="#FFF3CD" BorderBrush="#FFC107" BorderThickness="0,0,0,2"
                Padding="20,12" Visibility="{Binding Toolbar.ShowClearSlider, Converter={StaticResource BoolToVisibilityConverter}}">
            <Grid MaxWidth="900" HorizontalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*" MinWidth="400"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,30,0">
                    <Path Data="M13,14H11V10H13M13,18H11V16H13M1,21H23L12,2L1,21Z" Fill="#FF9800" Width="24" Height="24" Stretch="Uniform" Margin="0,0,12,0"/>
                    <TextBlock Text="滑动到右侧以清空所有批注" FontSize="14" FontWeight="SemiBold" Foreground="#856404" VerticalAlignment="Center"/>
                </StackPanel>

                <Grid Grid.Column="1" Margin="0,0,40,0" Height="60">
                    <!-- Background Track (light orange) -->
                    <Border Background="#FFE5B4" CornerRadius="20" Height="14" VerticalAlignment="Center" Margin="22,0"/>

                    <!-- Progress Track (dark orange, grows with slider) -->
                    <Border Background="#FF9800" CornerRadius="20,0,0,20" Height="14"
                            VerticalAlignment="Center" HorizontalAlignment="Left" Margin="22,0,0,0">
                        <Border.Width>
                            <MultiBinding Converter="{StaticResource SliderProgressConverter}">
                                <Binding Path="Toolbar.ClearSliderValue"/>
                                <Binding RelativeSource="{RelativeSource AncestorType=Grid}" Path="ActualWidth"/>
                            </MultiBinding>
                        </Border.Width>
                    </Border>

                    <!-- Checkmark (shown when slider reaches 100%) -->
                    <Border Background="#27AE60" CornerRadius="30" Width="60" Height="60"
                            HorizontalAlignment="Right" VerticalAlignment="Center"
                            Visibility="{Binding Toolbar.ShowCheckmark, Converter={StaticResource BoolToVisibilityConverter}}">
                        <Border.Effect>
                            <DropShadowEffect Color="#000000" BlurRadius="15" ShadowDepth="3" Opacity="0.5"/>
                        </Border.Effect>
                        <Path Data="M21,7L9,19L3.5,13.5L4.91,12.09L9,16.17L19.59,5.59L21,7Z"
                              Fill="White" Width="32" Height="32" Stretch="Uniform"
                              HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>

                    <!-- Slider -->
                    <Slider Value="{Binding Toolbar.ClearSliderValue}" Minimum="0" Maximum="100"
                            VerticalAlignment="Center" IsMoveToPointEnabled="True"
                            IsSnapToTickEnabled="False" TickFrequency="1"
                            Visibility="{Binding Toolbar.ShowCheckmark, Converter={StaticResource InverseBoolToVisibilityConverter}}">
                        <Slider.Style>
                            <Style TargetType="Slider">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Slider">
                                            <Grid>
                                                <Track x:Name="PART_Track">
                                                    <Track.DecreaseRepeatButton>
                                                        <RepeatButton Command="Slider.DecreaseLarge" Background="Transparent" BorderThickness="0"/>
                                                    </Track.DecreaseRepeatButton>
                                                    <Track.IncreaseRepeatButton>
                                                        <RepeatButton Command="Slider.IncreaseLarge" Background="Transparent" BorderThickness="0"/>
                                                    </Track.IncreaseRepeatButton>
                                                    <Track.Thumb>
                                                        <Thumb Width="44" Height="44" Cursor="Hand">
                                                            <Thumb.Template>
                                                                <ControlTemplate TargetType="Thumb">
                                                                    <Border Background="#FF9800" CornerRadius="22" BorderBrush="White" BorderThickness="3" Cursor="Hand">
                                                                        <Border.Effect>
                                                                            <DropShadowEffect Color="#000000" BlurRadius="12" ShadowDepth="3" Opacity="0.4"/>
                                                                        </Border.Effect>
                                                                        <Path Data="M8.59,16.58L13.17,12L8.59,7.41L10,6L16,12L10,18L8.59,16.58Z"
                                                                              Fill="White" Width="20" Height="20" Stretch="Uniform"
                                                                              HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                                    </Border>
                                                                </ControlTemplate>
                                                            </Thumb.Template>
                                                        </Thumb>
                                                    </Track.Thumb>
                                                </Track>
                                            </Grid>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </Slider.Style>
                    </Slider>
                </Grid>

                <Button Grid.Column="2" Command="{Binding Toolbar.ToggleClearSliderCommand}" Padding="16,10"
                        Background="Transparent" BorderBrush="#856404" BorderThickness="2" Cursor="Hand">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}"
                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                BorderThickness="{TemplateBinding BorderThickness}"
                                                CornerRadius="6" Padding="{TemplateBinding Padding}">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Background" Value="#856404"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </Button.Style>
                    <TextBlock Text="取消" FontSize="14" FontWeight="SemiBold" Foreground="#856404"/>
                </Button>
            </Grid>
        </Border>

        <!-- Multi-View Content Area -->
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Sidebar Navigation -->
            <Border Grid.Column="0" Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                    Visibility="{Binding IsHomeView, Converter={StaticResource BoolToVisibilityConverter}}"
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="0,0,1,0">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Width" Value="220"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsSidebarCollapsed}" Value="True">
                                <DataTrigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetProperty="Width"
                                                           To="60"
                                                           Duration="0:0:0.25">
                                                <DoubleAnimation.EasingFunction>
                                                    <QuadraticEase EasingMode="EaseInOut"/>
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </DataTrigger.EnterActions>
                                <DataTrigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetProperty="Width"
                                                           To="220"
                                                           Duration="0:0:0.25">
                                                <DoubleAnimation.EasingFunction>
                                                    <QuadraticEase EasingMode="EaseInOut"/>
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </DataTrigger.ExitActions>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <DockPanel LastChildFill="True">
                    <ToggleButton DockPanel.Dock="Top" Style="{StaticResource SidebarToggleButtonStyle}"
                                  IsChecked="{Binding IsSidebarCollapsed, Mode=TwoWay}"
                                  ToolTip="展开/折叠侧边栏"/>

                    <StackPanel Margin="0,8,0,0">
                        <Button Style="{StaticResource SidebarNavButtonStyle}" Command="{Binding ShowHomeCommand}" ToolTip="主页">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Path Data="{StaticResource IconHome}" Fill="#3498DB" Width="22" Height="22" Stretch="Uniform"/>
                                <TextBlock Text="主页" Margin="14,0,0,0" VerticalAlignment="Center" FontSize="14" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextFillColorPrimaryBrush}">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsSidebarCollapsed}" Value="True">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>
                        </Button>

                        <Button Style="{StaticResource SidebarNavButtonStyle}" Command="{Binding ShowToolboxCommand}" ToolTip="工具箱">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Path Data="{StaticResource IconToolbox}" Fill="#E67E22" Width="22" Height="22" Stretch="Uniform"/>
                                <TextBlock Text="工具箱" Margin="14,0,0,0" VerticalAlignment="Center" FontSize="14" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextFillColorPrimaryBrush}">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsSidebarCollapsed}" Value="True">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>
                        </Button>

                        <Button Style="{StaticResource SidebarNavButtonStyle}" Command="{Binding ShowSettingsCommand}" ToolTip="设置">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Path Data="{StaticResource IconSettings}" Fill="#95A5A6" Width="22" Height="22" Stretch="Uniform"/>
                                <TextBlock Text="设置" Margin="14,0,0,0" VerticalAlignment="Center" FontSize="14" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextFillColorPrimaryBrush}">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsSidebarCollapsed}" Value="True">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>
                        </Button>

                        <Button Style="{StaticResource SidebarNavButtonStyle}" Command="{Binding ShowAboutCommand}" ToolTip="关于">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Path Data="{StaticResource IconInfo}" Fill="#3498DB" Width="22" Height="22" Stretch="Uniform"/>
                                <TextBlock Text="关于" Margin="14,0,0,0" VerticalAlignment="Center" FontSize="14" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextFillColorPrimaryBrush}">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsSidebarCollapsed}" Value="True">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </DockPanel>
            </Border>

            <Grid Grid.Column="1">
            <!-- Home Page -->
            <ContentControl Visibility="{Binding IsHomeView, Converter={StaticResource BoolToVisibilityConverter}}">
                <ContentControl.Style>
                    <Style TargetType="ContentControl">
                        <Setter Property="Opacity" Value="0"/>
                        <Style.Triggers>
                            <Trigger Property="Visibility" Value="Visible">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                           From="0" To="1"
                                                           Duration="0:0:0.2"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </ContentControl.Style>
                <ContentControl.Content>
                    <Grid Background="{DynamicResource ApplicationBackgroundBrush}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- Header -->
                        <Border Grid.Row="0" Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" Padding="40,30" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="0,0,0,1">
                            <StackPanel>
                                <TextBlock Text="PDF 教学批注工具" FontSize="32" FontWeight="Bold" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                                <TextBlock Text="轻松为 PDF 添加批注和标记" FontSize="16" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,8,0,0"/>
                            </StackPanel>
                        </Border>

                        <!-- Content -->
                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                            <StackPanel Margin="40,30">
                                <!-- Quick Actions -->
                                <TextBlock Text="快速操作" FontSize="20" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" Margin="0,0,0,16"/>
                                <Button Command="{Binding OpenFileCommand}" Cursor="Hand"
                                        Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                                        BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                                        BorderThickness="1" Padding="30,20" Margin="0,0,0,40" HorizontalAlignment="Left">
                                    <Button.Style>
                                        <Style TargetType="Button">
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="Button">
                                                        <Border Background="{TemplateBinding Background}"
                                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                                BorderThickness="{TemplateBinding BorderThickness}"
                                                                CornerRadius="8" Padding="{TemplateBinding Padding}">
                                                            <Border.Effect>
                                                                <DropShadowEffect Color="#000000" BlurRadius="8" ShadowDepth="2" Opacity="0.1"/>
                                                            </Border.Effect>
                                                            <ContentPresenter/>
                                                        </Border>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter Property="Background" Value="{DynamicResource ControlFillColorSecondaryBrush}"/>
                                                            </Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                        </Style>
                                    </Button.Style>
                                    <StackPanel>
                                        <Path Data="{StaticResource IconOpen}" Fill="#3498DB" Width="48" Height="48" Stretch="Uniform" HorizontalAlignment="Center"/>
                                        <TextBlock Text="打开 PDF" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                                   HorizontalAlignment="Center" Margin="0,12,0,0"/>
                                        <TextBlock Text="浏览并打开 PDF 文件" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                   HorizontalAlignment="Center" Margin="0,4,0,0"/>
                                    </StackPanel>
                                </Button>

                                <!-- Recent Files -->
                                <TextBlock Text="最近访问" FontSize="20" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" Margin="0,0,0,16"/>

                                <!-- Recent Files List -->
                                <ItemsControl ItemsSource="{Binding RecentFiles}" Visibility="{Binding HasRecentFiles, Converter={StaticResource InverseBoolToVisibilityConverter}}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Button Tag="{Binding FilePath}" Click="RecentFile_Click" Cursor="Hand"
                                                    Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                                                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                                                    Padding="20" Margin="0,0,0,12" HorizontalContentAlignment="Stretch">
                                                <Button.Style>
                                                    <Style TargetType="Button">
                                                        <Setter Property="Template">
                                                            <Setter.Value>
                                                                <ControlTemplate TargetType="Button">
                                                                    <Border Background="{TemplateBinding Background}"
                                                                            BorderBrush="{TemplateBinding BorderBrush}"
                                                                            BorderThickness="{TemplateBinding BorderThickness}"
                                                                            CornerRadius="6" Padding="{TemplateBinding Padding}">
                                                                        <Border.Effect>
                                                                            <DropShadowEffect Color="#000000" BlurRadius="6" ShadowDepth="1" Opacity="0.08"/>
                                                                        </Border.Effect>
                                                                        <ContentPresenter/>
                                                                    </Border>
                                                                    <ControlTemplate.Triggers>
                                                                        <Trigger Property="IsMouseOver" Value="True">
                                                                            <Setter Property="Background" Value="{DynamicResource ControlFillColorSecondaryBrush}"/>
                                                                        </Trigger>
                                                                    </ControlTemplate.Triggers>
                                                                </ControlTemplate>
                                                            </Setter.Value>
                                                        </Setter>
                                                    </Style>
                                                </Button.Style>
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>

                                                    <Path Grid.Column="0" Data="M14,2H6A2,2 0 0,0 4,4V20A2,2 0 0,0 6,22H18A2,2 0 0,0 20,20V8L14,2M18,20H6V4H13V9H18V20Z"
                                                          Fill="#E74C3C" Width="32" Height="32" Stretch="Uniform" Margin="0,0,16,0"/>

                                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding FileName}" FontSize="15" FontWeight="SemiBold"
                                                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}" TextTrimming="CharacterEllipsis"/>
                                                        <TextBlock FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,4,0,0">
                                                            <Run Text="{Binding PageCount, StringFormat='{}{0} 页', Mode=OneWay}"/>
                                                            <Run Text=" • "/>
                                                            <Run Text="{Binding LastAccessed, StringFormat='上次访问: {0:yyyy-MM-dd HH:mm}', Mode=OneWay}"/>
                                                        </TextBlock>
                                                    </StackPanel>

                                                    <Path Grid.Column="2" Data="M8.59,16.58L13.17,12L8.59,7.41L10,6L16,12L10,18L8.59,16.58Z"
                                                          Fill="#BDC3C7" Width="24" Height="24" Stretch="Uniform" VerticalAlignment="Center"/>
                                                </Grid>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <!-- Empty State -->
                                <Border Background="White" BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="6"
                                        Padding="40" Visibility="{Binding HasRecentFiles, Converter={StaticResource BoolToVisibilityConverter}}">
                                    <StackPanel HorizontalAlignment="Center">
                                        <Path Data="M14,2H6A2,2 0 0,0 4,4V20A2,2 0 0,0 6,22H18A2,2 0 0,0 20,20V8L14,2M18,20H6V4H13V9H18V20Z"
                                              Fill="#BDC3C7" Width="64" Height="64" Stretch="Uniform" HorizontalAlignment="Center"/>
                                        <TextBlock Text="暂无最近文件" FontSize="16" Foreground="#7F8C8D"
                                                   HorizontalAlignment="Center" Margin="0,16,0,0"/>
                                        <TextBlock Text="打开一个 PDF 文件开始使用" FontSize="13" Foreground="#95A5A6"
                                                   HorizontalAlignment="Center" Margin="0,4,0,0"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>
                </ContentControl.Content>
            </ContentControl>

            <!-- Settings Page -->
            <ContentControl Visibility="{Binding IsSettingsView, Converter={StaticResource BoolToVisibilityConverter}}">
                <ContentControl.Style>
                    <Style TargetType="ContentControl">
                        <Setter Property="Opacity" Value="0"/>
                        <Style.Triggers>
                            <Trigger Property="Visibility" Value="Visible">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                           From="0" To="1"
                                                           Duration="0:0:0.2"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </ContentControl.Style>
                <ContentControl.Content>
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="40,30" HorizontalAlignment="Left">

                            <!-- Header -->
                            <TextBlock Text="设置" FontSize="32" FontWeight="Bold" Margin="0,0,0,8"/>
                            <TextBlock Text="自定义应用程序行为和外观" FontSize="14" Opacity="0.7" Margin="0,0,0,32"/>

                            <WrapPanel Orientation="Horizontal" ItemWidth="420" Margin="0,0,0,16">
                            <!-- General Settings -->
                            <ui:CardExpander Icon="{ui:SymbolIcon Settings24}" Header="常规设置" IsExpanded="True" Margin="0,0,16,16" Width="400">
                                <StackPanel Margin="0,16,0,0">
                                    <ui:CardControl Icon="{ui:SymbolIcon Save24}">
                                        <ui:CardControl.Header>
                                            <StackPanel>
                                                <TextBlock Text="自动保存批注" FontWeight="SemiBold"/>
                                                <TextBlock Text="关闭文件时自动保存批注，无需手动保存" FontSize="12" Opacity="0.7" Margin="0,4,0,0"/>
                                            </StackPanel>
                                        </ui:CardControl.Header>
                                        <ui:ToggleSwitch IsChecked="{Binding Settings.AutoSaveAnnotations}"/>
                                    </ui:CardControl>

                                    <ui:CardControl Icon="{ui:SymbolIcon Home24}" Margin="0,8,0,0">
                                        <ui:CardControl.Header>
                                            <StackPanel>
                                                <TextBlock Text="启动时显示主页" FontWeight="SemiBold"/>
                                                <TextBlock Text="应用启动时显示主页和最近文件" FontSize="12" Opacity="0.7" Margin="0,4,0,0"/>
                                            </StackPanel>
                                        </ui:CardControl.Header>
                                        <ui:ToggleSwitch IsChecked="{Binding Settings.ShowWelcomeScreen}"/>
                                    </ui:CardControl>

                                    <ui:CardControl Icon="{ui:SymbolIcon QuestionCircle24}" Margin="0,8,0,0">
                                        <ui:CardControl.Header>
                                            <StackPanel>
                                                <TextBlock Text="显示工具提示" FontWeight="SemiBold"/>
                                                <TextBlock Text="鼠标悬停时显示工具提示" FontSize="12" Opacity="0.7" Margin="0,4,0,0"/>
                                            </StackPanel>
                                        </ui:CardControl.Header>
                                        <ui:ToggleSwitch IsChecked="{Binding Settings.ShowToolTips}"/>
                                    </ui:CardControl>
                                </StackPanel>
                            </ui:CardExpander>

                            <!-- Drawing Settings -->
                            <ui:CardExpander Icon="{ui:SymbolIcon Edit24}" Header="绘图设置" IsExpanded="True" Margin="0,0,16,16" Width="400">
                                <StackPanel Margin="0,16,0,0">
                                    <ui:CardControl Icon="{ui:SymbolIcon Pen24}">
                                        <ui:CardControl.Header>
                                            <StackPanel>
                                                <TextBlock Text="默认画笔粗细" FontWeight="SemiBold"/>
                                                <TextBlock FontSize="12" Opacity="0.7" Margin="0,4,0,0">
                                                    <Run Text="当前值:"/>
                                                    <Run Text="{Binding Settings.DefaultPenSize, Mode=OneWay}" FontWeight="Bold"/>
                                                </TextBlock>
                                            </StackPanel>
                                        </ui:CardControl.Header>
                                        <Slider Value="{Binding Settings.DefaultPenSize}" Minimum="1" Maximum="20" Width="200"
                                                TickFrequency="1" IsSnapToTickEnabled="True"/>
                                    </ui:CardControl>

                                    <ui:CardControl Icon="{ui:SymbolIcon Delete24}" Margin="0,8,0,0">
                                        <ui:CardControl.Header>
                                            <StackPanel>
                                                <TextBlock Text="默认橡皮大小" FontWeight="SemiBold"/>
                                                <TextBlock FontSize="12" Opacity="0.7" Margin="0,4,0,0">
                                                    <Run Text="当前值:"/>
                                                    <Run Text="{Binding Settings.DefaultEraserSize, Mode=OneWay}" FontWeight="Bold"/>
                                                </TextBlock>
                                            </StackPanel>
                                        </ui:CardControl.Header>
                                        <Slider Value="{Binding Settings.DefaultEraserSize}" Minimum="5" Maximum="50" Width="200"
                                                TickFrequency="5" IsSnapToTickEnabled="True"/>
                                    </ui:CardControl>

                                    <ui:CardControl Icon="{ui:SymbolIcon Sparkle24}" Margin="0,8,0,0">
                                        <ui:CardControl.Header>
                                            <StackPanel>
                                                <TextBlock Text="平滑绘图" FontWeight="SemiBold"/>
                                                <TextBlock Text="启用笔画平滑处理，使线条更流畅" FontSize="12" Opacity="0.7" Margin="0,4,0,0"/>
                                            </StackPanel>
                                        </ui:CardControl.Header>
                                        <ui:ToggleSwitch IsChecked="{Binding Settings.EnableSmoothDrawing}"/>
                                    </ui:CardControl>
                                </StackPanel>
                            </ui:CardExpander>

                            <!-- View Settings -->
                            <ui:CardExpander Icon="{ui:SymbolIcon Eye24}" Header="视图设置" IsExpanded="True" Margin="0,0,16,16" Width="400">
                                <StackPanel Margin="0,16,0,0">
                                    <ui:CardControl Icon="{ui:SymbolIcon ZoomIn24}">
                                        <ui:CardControl.Header>
                                            <StackPanel>
                                                <TextBlock Text="默认缩放级别" FontWeight="SemiBold"/>
                                                <TextBlock FontSize="12" Opacity="0.7" Margin="0,4,0,0">
                                                    <Run Text="当前值:"/>
                                                    <Run Text="{Binding Settings.DefaultZoomLevel, StringFormat='{}{0:P0}', Mode=OneWay}" FontWeight="Bold"/>
                                                </TextBlock>
                                            </StackPanel>
                                        </ui:CardControl.Header>
                                        <Slider Value="{Binding Settings.DefaultZoomLevel}" Minimum="0.5" Maximum="2.0" Width="200"
                                                TickFrequency="0.1" IsSnapToTickEnabled="True"/>
                                    </ui:CardControl>
                                </StackPanel>
                            </ui:CardExpander>

                            <!-- Recent Files Settings -->
                            <ui:CardExpander Icon="{ui:SymbolIcon History24}" Header="最近文件" IsExpanded="True" Margin="0,0,16,16" Width="400">
                                <StackPanel Margin="0,16,0,0">
                                    <ui:CardControl Icon="{ui:SymbolIcon NumberSymbol24}">
                                        <ui:CardControl.Header>
                                            <StackPanel>
                                                <TextBlock Text="最大记录数量" FontWeight="SemiBold"/>
                                                <TextBlock FontSize="12" Opacity="0.7" Margin="0,4,0,0">
                                                    <Run Text="保存"/>
                                                    <Run Text="{Binding Settings.MaxRecentFiles, Mode=OneWay}" FontWeight="Bold"/>
                                                    <Run Text="个最近文件"/>
                                                </TextBlock>
                                            </StackPanel>
                                        </ui:CardControl.Header>
                                        <Slider Value="{Binding Settings.MaxRecentFiles}" Minimum="5" Maximum="20" Width="200"
                                                TickFrequency="1" IsSnapToTickEnabled="True"/>
                                    </ui:CardControl>

                                    <ui:CardControl Icon="{ui:SymbolIcon Delete24}" Margin="0,8,0,0">
                                        <ui:CardControl.Header>
                                            <StackPanel>
                                                <TextBlock Text="清空最近访问" FontWeight="SemiBold"/>
                                                <TextBlock Text="删除所有最近访问记录" FontSize="12" Opacity="0.7" Margin="0,4,0,0"/>
                                            </StackPanel>
                                        </ui:CardControl.Header>
                                        <ui:Button Content="清空" Appearance="Danger" Click="ClearRecent_Click"/>
                                    </ui:CardControl>
                                </StackPanel>
                            </ui:CardExpander>

                            <!-- Theme Settings -->
                            <ui:CardExpander Icon="{ui:SymbolIcon Color24}" Header="外观" IsExpanded="True" Margin="0,0,16,16" Width="400">
                                <StackPanel Margin="0,16,0,0">
                                    <ui:CardControl Icon="{ui:SymbolIcon WeatherMoon24}">
                                        <ui:CardControl.Header>
                                            <StackPanel>
                                                <TextBlock Text="主题" FontWeight="SemiBold"/>
                                                <TextBlock Text="选择应用程序主题" FontSize="12" Opacity="0.7" Margin="0,4,0,0"/>
                                            </StackPanel>
                                        </ui:CardControl.Header>
                                        <ComboBox SelectedItem="{Binding Settings.Theme}" Width="150">
                                            <ComboBoxItem Content="浅色" Tag="Light"/>
                                            <ComboBoxItem Content="深色" Tag="Dark"/>
                                            <ComboBoxItem Content="跟随系统" Tag="Auto"/>
                                        </ComboBox>
                                    </ui:CardControl>
                                </StackPanel>
                            </ui:CardExpander>

                            </WrapPanel>

                            <!-- Save Button -->
                            <StackPanel Orientation="Horizontal">
                                <ui:Button Content="保存设置" Appearance="Primary" Icon="{ui:SymbolIcon Save24}"
                                           Click="SaveSettings_Click" Padding="24,12" Margin="0,0,16,0"/>

                                <!-- Back Button -->
                                <ui:Button Content="返回" Appearance="Secondary" Icon="{ui:SymbolIcon ArrowLeft24}"
                                           Command="{Binding GoBackCommand}" Padding="24,12"/>
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>
                </ContentControl.Content>
            </ContentControl>

            <!-- About Page -->
            <ContentControl Visibility="{Binding IsAboutView, Converter={StaticResource BoolToVisibilityConverter}}">
                <ContentControl.Content>
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="40,30" HorizontalAlignment="Left">
                            <TextBlock Text="关于" FontSize="32" FontWeight="Bold" Margin="0,0,0,8"/>
                            <TextBlock Text="PDF 教学批注工具的版本信息和功能说明" FontSize="14" Opacity="0.7" Margin="0,0,0,32"/>

                            <WrapPanel Orientation="Horizontal" ItemWidth="420" Margin="0,0,0,16">
                            <ui:CardExpander Icon="{ui:SymbolIcon Info24}" Header="应用信息" IsExpanded="True" Margin="0,0,16,16" Width="400">
                                <StackPanel Margin="0,16,0,0">
                                    <ui:CardControl Icon="{ui:SymbolIcon DocumentPdf24}">
                                        <ui:CardControl.Header>
                                            <StackPanel>
                                                <TextBlock Text="PDF 教学批注工具" FontWeight="SemiBold"/>
                                                <TextBlock Text="面向教学场景的 PDF 批注和标记工具" FontSize="12" Opacity="0.7" Margin="0,4,0,0"/>
                                            </StackPanel>
                                        </ui:CardControl.Header>
                                    </ui:CardControl>

                                    <ui:CardControl Icon="{ui:SymbolIcon Sparkle24}" Margin="0,8,0,0">
                                        <ui:CardControl.Header>
                                            <StackPanel>
                                                <TextBlock Text="核心功能" FontWeight="SemiBold"/>
                                                <TextBlock Text="PDF 浏览、画笔批注、橡皮擦除、批注保存、撤销/重做" FontSize="12" Opacity="0.7" Margin="0,4,0,0"/>
                                            </StackPanel>
                                        </ui:CardControl.Header>
                                    </ui:CardControl>
                                </StackPanel>
                            </ui:CardExpander>

                            <ui:CardExpander Icon="{ui:SymbolIcon Keyboard24}" Header="快捷键" IsExpanded="True" Margin="0,0,16,16" Width="400">
                                <StackPanel Margin="0,16,0,0">
                                    <ui:CardControl Icon="{ui:SymbolIcon FolderOpen24}">
                                        <ui:CardControl.Header>
                                            <TextBlock Text="Ctrl+O 打开 PDF" FontWeight="SemiBold"/>
                                        </ui:CardControl.Header>
                                    </ui:CardControl>
                                    <ui:CardControl Icon="{ui:SymbolIcon Save24}" Margin="0,8,0,0">
                                        <ui:CardControl.Header>
                                            <TextBlock Text="Ctrl+S 保存批注" FontWeight="SemiBold"/>
                                        </ui:CardControl.Header>
                                    </ui:CardControl>
                                    <ui:CardControl Icon="{ui:SymbolIcon ArrowUndo24}" Margin="0,8,0,0">
                                        <ui:CardControl.Header>
                                            <TextBlock Text="Ctrl+Z 撤销，Ctrl+Y / Ctrl+Shift+Z 重做" FontWeight="SemiBold"/>
                                        </ui:CardControl.Header>
                                    </ui:CardControl>
                                </StackPanel>
                            </ui:CardExpander>

                            </WrapPanel>

                            <StackPanel Orientation="Horizontal">
                                <ui:Button Content="返回" Appearance="Secondary" Icon="{ui:SymbolIcon ArrowLeft24}"
                                           Command="{Binding GoBackCommand}" Padding="24,12"/>
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>
                </ContentControl.Content>
            </ContentControl>

            <!-- Toolbox View -->
            <ContentControl Visibility="{Binding IsToolboxView, Converter={StaticResource BoolToVisibilityConverter}}">
                <ContentControl.Style>
                    <Style TargetType="ContentControl">
                        <Setter Property="Opacity" Value="0"/>
                        <Style.Triggers>
                            <Trigger Property="Visibility" Value="Visible">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                           From="0" To="1"
                                                           Duration="0:0:0.2"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </ContentControl.Style>
                <ContentControl.Content>
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="40,30" MaxWidth="900">
                            <!-- Header -->
                            <StackPanel Margin="0,0,0,30">
                                <TextBlock Text="工具箱" FontSize="32" FontWeight="Bold"
                                          Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                                <TextBlock Text="实用工具集合" FontSize="14" Margin="0,8,0,0"
                                          Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                            </StackPanel>

                            <!-- OCR Tool -->
                            <ui:CardExpander Icon="{ui:SymbolIcon DocumentText24}" Header="OCR 文字识别" IsExpanded="True" Margin="0,0,0,16" Width="850">
                                <StackPanel Margin="0,16,0,0">
                                    <TextBlock Text="识别 PDF 中的文字内容（支持中英文）" FontSize="13" Opacity="0.7" Margin="0,0,0,16"/>

                                    <!-- Start OCR Button -->
                                    <ui:Button Content="开始识别" Icon="{ui:SymbolIcon Play24}"
                                             Command="{Binding StartOcrCommand}"
                                             IsEnabled="{Binding IsOcrRunning, Converter={StaticResource InvertBoolConverter}}"
                                             Appearance="Primary" Margin="0,0,0,16"/>

                                    <!-- Progress Bar -->
                                    <StackPanel Visibility="{Binding IsOcrRunning, Converter={StaticResource BoolToVisibilityConverter}}" Margin="0,0,0,16">
                                        <TextBlock Text="{Binding OcrProgressText}" FontSize="13" Margin="0,0,0,8"/>
                                        <ProgressBar IsIndeterminate="True" Height="4"/>
                                    </StackPanel>

                                    <!-- Result TextBox -->
                                    <TextBlock Text="识别结果：" FontWeight="SemiBold" Margin="0,0,0,8"/>
                                    <TextBox Text="{Binding OcrResult, Mode=OneWay}"
                                           IsReadOnly="True"
                                           TextWrapping="Wrap"
                                           AcceptsReturn="True"
                                           VerticalScrollBarVisibility="Auto"
                                           Height="300"
                                           Padding="12"
                                           FontFamily="Consolas"
                                           FontSize="12"
                                           Margin="0,0,0,12"/>

                                    <!-- Copy Result Button -->
                                    <ui:Button Content="复制结果" Icon="{ui:SymbolIcon Copy24}"
                                             Command="{Binding CopyOcrResultCommand}"
                                             Appearance="Secondary"/>
                                </StackPanel>
                            </ui:CardExpander>

                            <StackPanel Orientation="Horizontal">
                                <ui:Button Content="返回" Appearance="Secondary" Icon="{ui:SymbolIcon ArrowLeft24}"
                                          Command="{Binding GoBackCommand}" Padding="24,12"/>
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>
                </ContentControl.Content>
            </ContentControl>

            <!-- PDF View -->
            <Grid Visibility="{Binding IsPdfView, Converter={StaticResource BoolToVisibilityConverter}}">
                <Grid.Style>
                    <Style TargetType="Grid">
                        <Setter Property="Opacity" Value="0"/>
                        <Style.Triggers>
                            <Trigger Property="Visibility" Value="Visible">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                           From="0" To="1"
                                                           Duration="0:0:0.2"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>
                <ListBox x:Name="PagesControl"
                         ItemsSource="{Binding Pages}"
                         Background="{DynamicResource ApplicationBackgroundBrush}"
                         BorderThickness="0"
                         Margin="0,0,46,0"
                         Loaded="PagesControl_Loaded"
                         PreviewMouseWheel="ScrollViewer_PreviewMouseWheel"
                         SizeChanged="ScrollViewer_SizeChanged"
                         ScrollViewer.HorizontalScrollBarVisibility="Auto"
                         ScrollViewer.VerticalScrollBarVisibility="Auto"
                         ScrollViewer.CanContentScroll="True"
                         VirtualizingPanel.IsVirtualizing="True"
                         VirtualizingPanel.VirtualizationMode="Recycling"
                         VirtualizingPanel.CacheLength="2"
                         VirtualizingPanel.CacheLengthUnit="Item"
                         VirtualizingPanel.ScrollUnit="Pixel">
                    <ListBox.ItemsPanel>
                            <ItemsPanelTemplate>
                            <VirtualizingStackPanel Orientation="Vertical"/>
                            </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="HorizontalContentAlignment" Value="Center"/>
                            <Setter Property="Padding" Value="0"/>
                            <Setter Property="Margin" Value="0"/>
                            <Setter Property="Focusable" Value="False"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <ContentPresenter/>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Margin="0,10" HorizontalAlignment="Center" Background="White"
                                        BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="4">
                                    <Border.LayoutTransform>
                                        <ScaleTransform ScaleX="{Binding DataContext.ZoomLevel, RelativeSource={RelativeSource AncestorType=Window}}"
                                                        ScaleY="{Binding DataContext.ZoomLevel, RelativeSource={RelativeSource AncestorType=Window}}"/>
                                    </Border.LayoutTransform>
                                    <Border.Effect>
                                        <DropShadowEffect Color="#000000" BlurRadius="12" ShadowDepth="3" Opacity="0.15"/>
                                    </Border.Effect>
                                    <Grid HorizontalAlignment="Center"
                                          Width="{Binding PageWidth}"
                                          Height="{Binding PageHeight}">
                                        <Image Source="{Binding Image}"
                                               Width="{Binding PageWidth}"
                                               Height="{Binding PageHeight}"
                                               Stretch="None"/>
                                        <InkCanvas Strokes="{Binding Strokes}"
                                                   Width="{Binding PageWidth}"
                                                   Height="{Binding PageHeight}"
                                                   Background="Transparent"
                                                   Loaded="InkCanvas_Loaded"
                                                   StrokeCollected="InkCanvas_StrokeCollected"
                                                   StrokeErased="InkCanvas_StrokeErased"
                                                   EditingMode="{Binding DataContext.Toolbar.ActiveTool, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource ToolModeConverter}}"
                                                   DefaultDrawingAttributes="{Binding DataContext.Toolbar.DrawingAttributes, RelativeSource={RelativeSource AncestorType=Window}}"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>
            </Grid>
        </Grid>
    </DockPanel>
    </Grid>
</ui:FluentWindow>
