<UserControl x:Class="PdfTeachAnnotator.Views.SettingsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="600" d:DesignWidth="900"
             Background="#F8F9FA">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="White" Padding="40,30" BorderBrush="#E0E0E0" BorderThickness="0,0,0,1">
            <StackPanel>
                <TextBlock Text="设置" FontSize="32" FontWeight="Bold" Foreground="#2C3E50"/>
                <TextBlock Text="自定义应用程序行为" FontSize="16" Foreground="#7F8C8D" Margin="0,8,0,0"/>
            </StackPanel>
        </Border>

        <!-- Content -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="40,30" MaxWidth="700" HorizontalAlignment="Left">

                <!-- General Settings -->
                <TextBlock Text="常规设置" FontSize="20" FontWeight="SemiBold" Foreground="#34495E" Margin="0,0,0,16"/>

                <Border Background="White" BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="6" Padding="24" Margin="0,0,0,20">
                    <Border.Effect>
                        <DropShadowEffect Color="#000000" BlurRadius="6" ShadowDepth="1" Opacity="0.08"/>
                    </Border.Effect>
                    <StackPanel>
                        <CheckBox IsChecked="{Binding AutoSaveAnnotations}" Foreground="#2C3E50" FontSize="14">
                            <TextBlock Text="自动保存批注" FontWeight="SemiBold"/>
                        </CheckBox>
                        <TextBlock Text="关闭文件时自动保存批注，无需手动保存" FontSize="12" Foreground="#7F8C8D" Margin="28,4,0,0"/>

                        <CheckBox IsChecked="{Binding ShowWelcomeScreen}" Foreground="#2C3E50" FontSize="14" Margin="0,20,0,0">
                            <TextBlock Text="启动时显示主页" FontWeight="SemiBold"/>
                        </CheckBox>
                        <TextBlock Text="应用启动时显示主页和最近文件" FontSize="12" Foreground="#7F8C8D" Margin="28,4,0,0"/>
                    </StackPanel>
                </Border>

                <!-- Recent Files Settings -->
                <TextBlock Text="最近文件" FontSize="20" FontWeight="SemiBold" Foreground="#34495E" Margin="0,20,0,16"/>

                <Border Background="White" BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="6" Padding="24" Margin="0,0,0,20">
                    <Border.Effect>
                        <DropShadowEffect Color="#000000" BlurRadius="6" ShadowDepth="1" Opacity="0.08"/>
                    </Border.Effect>
                    <StackPanel>
                        <TextBlock Text="最大记录数量" FontSize="14" FontWeight="SemiBold" Foreground="#2C3E50"/>
                        <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                            <Slider Value="{Binding MaxRecentFiles}" Minimum="5" Maximum="20" Width="200"
                                    TickFrequency="1" IsSnapToTickEnabled="True" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding MaxRecentFiles}" FontSize="14" FontWeight="Bold"
                                       Foreground="#3498DB" Margin="16,0,0,0" VerticalAlignment="Center" MinWidth="30"/>
                            <TextBlock Text="个文件" FontSize="14" Foreground="#7F8C8D" VerticalAlignment="Center" Margin="4,0,0,0"/>
                        </StackPanel>

                        <Button Click="ClearRecent_Click" Margin="0,20,0,0" Padding="16,10" HorizontalAlignment="Left"
                                Background="#E74C3C" Foreground="White" BorderThickness="0" Cursor="Hand">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="Button">
                                                <Border Background="{TemplateBinding Background}"
                                                        CornerRadius="4" Padding="{TemplateBinding Padding}">
                                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter Property="Background" Value="#C0392B"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </Button.Style>
                            <StackPanel Orientation="Horizontal">
                                <Path Data="M19,4H15.5L14.5,3H9.5L8.5,4H5V6H19M6,19A2,2 0 0,0 8,21H16A2,2 0 0,0 18,19V7H6V19Z"
                                      Fill="White" Width="16" Height="16" Stretch="Uniform" Margin="0,0,8,0"/>
                                <TextBlock Text="清空最近访问" FontWeight="SemiBold"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Border>

                <!-- Theme Settings (Future) -->
                <TextBlock Text="外观" FontSize="20" FontWeight="SemiBold" Foreground="#34495E" Margin="0,20,0,16"/>

                <Border Background="White" BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="6" Padding="24" Margin="0,0,0,20">
                    <Border.Effect>
                        <DropShadowEffect Color="#000000" BlurRadius="6" ShadowDepth="1" Opacity="0.08"/>
                    </Border.Effect>
                    <StackPanel>
                        <TextBlock Text="主题" FontSize="14" FontWeight="SemiBold" Foreground="#2C3E50"/>
                        <ComboBox SelectedItem="{Binding Theme}" Margin="0,12,0,0" Padding="12,8" FontSize="14">
                            <ComboBoxItem Content="浅色" Tag="Light"/>
                            <ComboBoxItem Content="深色（即将推出）" Tag="Dark" IsEnabled="False"/>
                        </ComboBox>
                    </StackPanel>
                </Border>

                <!-- Save Button -->
                <Button Click="SaveSettings_Click" Padding="24,12" HorizontalAlignment="Left"
                        Background="#27AE60" Foreground="White" BorderThickness="0" Cursor="Hand" Margin="0,20,0,40">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}"
                                                CornerRadius="6" Padding="{TemplateBinding Padding}">
                                            <Border.Effect>
                                                <DropShadowEffect Color="#000000" BlurRadius="8" ShadowDepth="2" Opacity="0.15"/>
                                            </Border.Effect>
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Background" Value="#229954"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </Button.Style>
                    <StackPanel Orientation="Horizontal">
                        <Path Data="M15,9H5V5H15M12,19A3,3 0 0,1 9,16A3,3 0 0,1 12,13A3,3 0 0,1 15,16A3,3 0 0,1 12,19M17,3H5C3.89,3 3,3.9 3,5V19A2,2 0 0,0 5,21H19A2,2 0 0,0 21,19V7L17,3Z"
                              Fill="White" Width="18" Height="18" Stretch="Uniform" Margin="0,0,10,0"/>
                        <TextBlock Text="保存设置" FontSize="15" FontWeight="SemiBold"/>
                    </StackPanel>
                </Button>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
