<Window x:Class="PdfTeachAnnotator.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:PdfTeachAnnotator.Converters"
        Title="PDF 教学批注工具" Height="700" Width="1000"
        WindowState="Maximized"
        AllowDrop="True" Drop="Window_Drop" DragOver="Window_DragOver">
    <Window.Resources>
        <local:ColorToBrushConverter x:Key="ColorToBrushConverter"/>
        <local:ToolModeToEditingModeConverter x:Key="ToolModeConverter"/>
        <local:BoolToFontWeightConverter x:Key="BoolToFontWeight"/>
        <local:ColorSelectedConverter x:Key="ColorSelectedConverter"/>

        <!-- Material-style vector icon geometries -->
        <Geometry x:Key="IconOpen">M19,20H4C2.89,20 2,19.1 2,18V6C2,4.89 2.89,4 4,4H10L12,6H19A2,2 0 0,1 21,8H4V18L6.14,10H22.14L20,18C19.79,18.84 19,20 19,20Z</Geometry>
        <Geometry x:Key="IconSave">M15,9H5V5H15M12,19A3,3 0 0,1 9,16A3,3 0 0,1 12,13A3,3 0 0,1 15,16A3,3 0 0,1 12,19M17,3H5C3.89,3 3,3.9 3,5V19A2,2 0 0,0 5,21H19A2,2 0 0,0 21,19V7L17,3Z</Geometry>
        <Geometry x:Key="IconPen">M20.71,7.04C21.1,6.65 21.1,6 20.71,5.63L18.37,3.29C18,2.9 17.35,2.9 16.96,3.29L15.12,5.12L18.87,8.87M3,17.25V21H6.75L17.81,9.93L14.06,6.18L3,17.25Z</Geometry>
        <Geometry x:Key="IconEraser">M16.24,3.56L21.19,8.5C21.97,9.29 21.97,10.55 21.19,11.34L12,20.53C10.44,22.09 7.91,22.09 6.34,20.53L2.81,17C2.03,16.21 2.03,14.95 2.81,14.16L13.41,3.56C14.2,2.78 15.46,2.78 16.24,3.56M4.22,15.58L7.76,19.11C8.54,19.9 9.8,19.9 10.59,19.11L14.12,15.58L9.17,10.63L4.22,15.58Z</Geometry>
        <Geometry x:Key="IconClear">M19,4H15.5L14.5,3H9.5L8.5,4H5V6H19M6,19A2,2 0 0,0 8,21H16A2,2 0 0,0 18,19V7H6V19Z</Geometry>
        <Geometry x:Key="IconZoomIn">M15.5,14L20.5,19L19,20.5L14,15.5V14.71L13.73,14.43C12.59,15.41 11.11,16 9.5,16A6.5,6.5 0 0,1 3,9.5A6.5,6.5 0 0,1 9.5,3A6.5,6.5 0 0,1 16,9.5C16,11.11 15.41,12.59 14.43,13.73L14.71,14H15.5M9.5,14C12,14 14,12 14,9.5C14,7 12,5 9.5,5C7,5 5,7 5,9.5C5,12 7,14 9.5,14M12,10H10V12H9V10H7V9H9V7H10V9H12V10Z</Geometry>
        <Geometry x:Key="IconZoomOut">M15.5,14H14.71L14.43,13.73C15.41,12.59 16,11.11 16,9.5A6.5,6.5 0 0,0 9.5,3A6.5,6.5 0 0,0 3,9.5A6.5,6.5 0 0,0 9.5,16C11.11,16 12.59,15.41 13.73,14.43L14,14.71V15.5L19,20.5L20.5,19L15.5,14M9.5,14C7,14 5,12 5,9.5C5,7 7,5 9.5,5C12,5 14,7 14,9.5C14,12 12,14 9.5,14M7,9H12V10H7V9Z</Geometry>
        <Geometry x:Key="IconZoomReset">M12,5V1L7,6L12,11V7A6,6 0 0,1 18,13A6,6 0 0,1 12,19A6,6 0 0,1 6,13H4A8,8 0 0,0 12,21A8,8 0 0,0 20,13A8,8 0 0,0 12,5Z</Geometry>
        <Geometry x:Key="IconExit">M16,17V14H9V10H16V7L21,12L16,17M14,2A2,2 0 0,1 16,4V6H14V4H5V20H14V18H16V20A2,2 0 0,1 14,22H5A2,2 0 0,1 3,20V4A2,2 0 0,1 5,2H14Z</Geometry>

        <!-- Icon button style: 32x32 square button with vector icon -->
        <Style x:Key="IconButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="34"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="Margin" Value="2,0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1" CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#E0EAF8"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#A0C0E8"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#C0D8F0"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Icon toggle button style -->
        <Style x:Key="IconToggleButtonStyle" TargetType="ToggleButton">
            <Setter Property="Width" Value="34"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="Margin" Value="2,0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1" CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#E0EAF8"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#A0C0E8"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#B8D4F0"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#4A90D9"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <DockPanel>
        <Menu DockPanel.Dock="Top">
            <MenuItem Header="文件(_F)">
                <MenuItem Header="打开 PDF..." Command="{Binding OpenFileCommand}" InputGestureText="Ctrl+O"/>
                <MenuItem Header="保存批注" Command="{Binding SaveCommand}" InputGestureText="Ctrl+S"/>
                <Separator/>
                <MenuItem Header="退出" Click="Exit_Click"/>
            </MenuItem>
        </Menu>

        <!-- Annotation Toolbar -->
        <ToolBarTray DockPanel.Dock="Top" Background="#F5F7FA">
            <ToolBar Background="#F5F7FA">
                <Button Style="{StaticResource IconButtonStyle}" Command="{Binding OpenFileCommand}" ToolTip="打开 PDF (Ctrl+O)">
                    <Path Data="{StaticResource IconOpen}" Fill="#5A6470" Width="20" Height="20" Stretch="Uniform"/>
                </Button>
                <Button Style="{StaticResource IconButtonStyle}" Command="{Binding SaveCommand}" ToolTip="保存批注 (Ctrl+S)">
                    <Path Data="{StaticResource IconSave}" Fill="#5A6470" Width="20" Height="20" Stretch="Uniform"/>
                </Button>
                <Separator/>
                <ToggleButton Style="{StaticResource IconToggleButtonStyle}"
                              IsChecked="{Binding Toolbar.IsPenActive, Mode=OneWay}"
                              Command="{Binding Toolbar.SelectPenCommand}" ToolTip="画笔">
                    <Path Data="{StaticResource IconPen}" Fill="#5A6470" Width="20" Height="20" Stretch="Uniform"/>
                </ToggleButton>
                <ToggleButton Style="{StaticResource IconToggleButtonStyle}"
                              IsChecked="{Binding Toolbar.IsEraserActive, Mode=OneWay}"
                              Command="{Binding Toolbar.SelectEraserCommand}" ToolTip="橡皮">
                    <Path Data="{StaticResource IconEraser}" Fill="#5A6470" Width="20" Height="20" Stretch="Uniform"/>
                </ToggleButton>
                <Button Style="{StaticResource IconButtonStyle}" Command="{Binding Toolbar.ClearAllCommand}" ToolTip="清空所有批注">
                    <Path Data="{StaticResource IconClear}" Fill="#D9534F" Width="20" Height="20" Stretch="Uniform"/>
                </Button>
                <Separator/>
                <!-- Color Palette -->
                <TextBlock Text="颜色" VerticalAlignment="Center" Margin="6,0,4,0" Foreground="#5A6470"/>
                <ItemsControl ItemsSource="{Binding Toolbar.PenColors}" Margin="2,0">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Width="26" Height="26" Margin="2" BorderThickness="2.5" Cursor="Hand" CornerRadius="13"
                                    Background="{Binding Converter={StaticResource ColorToBrushConverter}}"
                                    MouseLeftButtonDown="ColorSwatch_Click" Tag="{Binding}">
                                <Border.BorderBrush>
                                    <MultiBinding Converter="{StaticResource ColorSelectedConverter}">
                                        <Binding/>
                                        <Binding Path="DataContext.Toolbar.SelectedColor" RelativeSource="{RelativeSource AncestorType=Window}"/>
                                    </MultiBinding>
                                </Border.BorderBrush>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <Separator/>
                <!-- Pen Size -->
                <TextBlock Text="笔粗" VerticalAlignment="Center" Margin="6,0,4,0" Foreground="#5A6470"/>
                <Slider Value="{Binding Toolbar.PenSize}" Minimum="1" Maximum="20" Width="70"
                        VerticalAlignment="Center" ToolTip="画笔粗细"/>
                <Separator/>
                <!-- Eraser Size -->
                <TextBlock Text="擦头" VerticalAlignment="Center" Margin="6,0,4,0" Foreground="#5A6470"/>
                <Slider Value="{Binding Toolbar.EraserSize}" Minimum="5" Maximum="50" Width="80"
                        VerticalAlignment="Center" ToolTip="橡皮大小"/>
                <Separator/>
                <!-- Zoom -->
                <Button Style="{StaticResource IconButtonStyle}" Command="{Binding ZoomOutCommand}" ToolTip="缩小">
                    <Path Data="{StaticResource IconZoomOut}" Fill="#5A6470" Width="20" Height="20" Stretch="Uniform"/>
                </Button>
                <TextBlock Text="{Binding ZoomPercent}" VerticalAlignment="Center" Margin="6,0" MinWidth="44"
                           TextAlignment="Center" Foreground="#3A4452" FontWeight="SemiBold"/>
                <Button Style="{StaticResource IconButtonStyle}" Command="{Binding ZoomInCommand}" ToolTip="放大">
                    <Path Data="{StaticResource IconZoomIn}" Fill="#5A6470" Width="20" Height="20" Stretch="Uniform"/>
                </Button>
                <Button Style="{StaticResource IconButtonStyle}" Command="{Binding ZoomResetCommand}" ToolTip="重置缩放">
                    <Path Data="{StaticResource IconZoomReset}" Fill="#5A6470" Width="20" Height="20" Stretch="Uniform"/>
                </Button>
            </ToolBar>
        </ToolBarTray>

        <!-- PDF Content with InkCanvas overlay -->
        <ScrollViewer x:Name="PdfScrollViewer"
                      HorizontalScrollBarVisibility="Auto"
                      VerticalScrollBarVisibility="Auto"
                      PreviewMouseWheel="ScrollViewer_PreviewMouseWheel"
                      SizeChanged="ScrollViewer_SizeChanged"
                      Background="#E8ECF0">
            <ItemsControl ItemsSource="{Binding Pages}" x:Name="PagesControl">
                <ItemsControl.LayoutTransform>
                    <ScaleTransform ScaleX="{Binding ZoomLevel}" ScaleY="{Binding ZoomLevel}"/>
                </ItemsControl.LayoutTransform>
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Vertical" HorizontalAlignment="Center"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Margin="0,6" HorizontalAlignment="Center" Background="White"
                                BorderBrush="#D0D6DC" BorderThickness="1">
                            <Border.Effect>
                                <DropShadowEffect Color="#202020" BlurRadius="8" ShadowDepth="2" Opacity="0.15"/>
                            </Border.Effect>
                            <Grid HorizontalAlignment="Center">
                                <Image Source="{Binding Image}" Stretch="None"/>
                                <InkCanvas Strokes="{Binding Strokes}"
                                           Background="Transparent"
                                           EditingMode="{Binding DataContext.Toolbar.ActiveTool, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource ToolModeConverter}}"
                                           DefaultDrawingAttributes="{Binding DataContext.Toolbar.DrawingAttributes, RelativeSource={RelativeSource AncestorType=Window}}"/>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </DockPanel>
</Window>
