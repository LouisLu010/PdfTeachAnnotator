<Window x:Class="PdfTeachAnnotator.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:PdfTeachAnnotator.Converters"
        Title="PDF 教学批注工具" Height="700" Width="1000"
        WindowState="Maximized"
        AllowDrop="True" Drop="Window_Drop" DragOver="Window_DragOver">
    <Window.Resources>
        <local:ColorToBrushConverter x:Key="ColorToBrushConverter"/>
        <local:ToolModeToEditingModeConverter x:Key="ToolModeConverter"/>
        <local:BoolToFontWeightConverter x:Key="BoolToFontWeight"/>
        <local:ColorSelectedConverter x:Key="ColorSelectedConverter"/>
        <local:PenIconColorConverter x:Key="PenIconColorConverter"/>
        <local:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
        <local:InverseBoolToVisibilityConverter x:Key="InverseBoolToVisibilityConverter"/>

        <!-- Material-style vector icon geometries -->
        <Geometry x:Key="IconOpen">M19,20H4C2.89,20 2,19.1 2,18V6C2,4.89 2.89,4 4,4H10L12,6H19A2,2 0 0,1 21,8H4V18L6.14,10H22.14L20,18C19.79,18.84 19,20 19,20Z</Geometry>
        <Geometry x:Key="IconSave">M15,9H5V5H15M12,19A3,3 0 0,1 9,16A3,3 0 0,1 12,13A3,3 0 0,1 15,16A3,3 0 0,1 12,19M17,3H5C3.89,3 3,3.9 3,5V19A2,2 0 0,0 5,21H19A2,2 0 0,0 21,19V7L17,3Z</Geometry>
        <Geometry x:Key="IconPen">M20.71,7.04C21.1,6.65 21.1,6 20.71,5.63L18.37,3.29C18,2.9 17.35,2.9 16.96,3.29L15.12,5.12L18.87,8.87M3,17.25V21H6.75L17.81,9.93L14.06,6.18L3,17.25Z</Geometry>
        <Geometry x:Key="IconEraser">M16.24,3.56L21.19,8.5C21.97,9.29 21.97,10.55 21.19,11.34L12,20.53C10.44,22.09 7.91,22.09 6.34,20.53L2.81,17C2.03,16.21 2.03,14.95 2.81,14.16L13.41,3.56C14.2,2.78 15.46,2.78 16.24,3.56M4.22,15.58L7.76,19.11C8.54,19.9 9.8,19.9 10.59,19.11L14.12,15.58L9.17,10.63L4.22,15.58Z</Geometry>
        <Geometry x:Key="IconClear">M19,4H15.5L14.5,3H9.5L8.5,4H5V6H19M6,19A2,2 0 0,0 8,21H16A2,2 0 0,0 18,19V7H6V19Z</Geometry>
        <Geometry x:Key="IconZoomIn">M15.5,14L20.5,19L19,20.5L14,15.5V14.71L13.73,14.43C12.59,15.41 11.11,16 9.5,16A6.5,6.5 0 0,1 3,9.5A6.5,6.5 0 0,1 9.5,3A6.5,6.5 0 0,1 16,9.5C16,11.11 15.41,12.59 14.43,13.73L14.71,14H15.5M9.5,14C12,14 14,12 14,9.5C14,7 12,5 9.5,5C7,5 5,7 5,9.5C5,12 7,14 9.5,14M12,10H10V12H9V10H7V9H9V7H10V9H12V10Z</Geometry>
        <Geometry x:Key="IconZoomOut">M15.5,14H14.71L14.43,13.73C15.41,12.59 16,11.11 16,9.5A6.5,6.5 0 0,0 9.5,3A6.5,6.5 0 0,0 3,9.5A6.5,6.5 0 0,0 9.5,16C11.11,16 12.59,15.41 13.73,14.43L14,14.71V15.5L19,20.5L20.5,19L15.5,14M9.5,14C7,14 5,12 5,9.5C5,7 7,5 9.5,5C12,5 14,7 14,9.5C14,12 12,14 9.5,14M7,9H12V10H7V9Z</Geometry>
        <Geometry x:Key="IconZoomReset">M12,5V1L7,6L12,11V7A6,6 0 0,1 18,13A6,6 0 0,1 12,19A6,6 0 0,1 6,13H4A8,8 0 0,0 12,21A8,8 0 0,0 20,13A8,8 0 0,0 12,5Z</Geometry>
        <Geometry x:Key="IconExit">M16,17V14H9V10H16V7L21,12L16,17M14,2A2,2 0 0,1 16,4V6H14V4H5V20H14V18H16V20A2,2 0 0,1 14,22H5A2,2 0 0,1 3,20V4A2,2 0 0,1 5,2H14Z</Geometry>

        <!-- Icon button style: 32x32 square button with vector icon -->
        <Style x:Key="IconButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="36"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="Margin" Value="3,0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1" CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#E3F2FD"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#90CAF9"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#BBDEFB"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Icon toggle button style -->
        <Style x:Key="IconToggleButtonStyle" TargetType="ToggleButton">
            <Setter Property="Width" Value="36"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="Margin" Value="3,0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1" CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#E3F2FD"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#90CAF9"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#2196F3"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#1976D2"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <DockPanel>
        <Menu DockPanel.Dock="Top" Background="#FFFFFF" Padding="8,4">
            <MenuItem Header="文件(_F)" Foreground="#2C3E50" FontWeight="Medium">
                <MenuItem Header="主页" Command="{Binding ShowHomeCommand}">
                    <MenuItem.Icon>
                        <Path Data="M10,20V14H14V20H19V12H22L12,3L2,12H5V20H10Z" Fill="#3498DB" Width="16" Height="16" Stretch="Uniform"/>
                    </MenuItem.Icon>
                </MenuItem>
                <Separator/>
                <MenuItem Header="打开 PDF..." Command="{Binding OpenFileCommand}" InputGestureText="Ctrl+O">
                    <MenuItem.Icon>
                        <Path Data="{StaticResource IconOpen}" Fill="#3498DB" Width="16" Height="16" Stretch="Uniform"/>
                    </MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="保存批注" Command="{Binding SaveCommand}" InputGestureText="Ctrl+S">
                    <MenuItem.Icon>
                        <Path Data="{StaticResource IconSave}" Fill="#27AE60" Width="16" Height="16" Stretch="Uniform"/>
                    </MenuItem.Icon>
                </MenuItem>
                <Separator/>
                <MenuItem Header="设置" Command="{Binding ShowSettingsCommand}">
                    <MenuItem.Icon>
                        <Path Data="M12,15.5A3.5,3.5 0 0,1 8.5,12A3.5,3.5 0 0,1 12,8.5A3.5,3.5 0 0,1 15.5,12A3.5,3.5 0 0,1 12,15.5M19.43,12.97C19.47,12.65 19.5,12.33 19.5,12C19.5,11.67 19.47,11.34 19.43,11L21.54,9.37C21.73,9.22 21.78,8.95 21.66,8.73L19.66,5.27C19.54,5.05 19.27,4.96 19.05,5.05L16.56,6.05C16.04,5.66 15.5,5.32 14.87,5.07L14.5,2.42C14.46,2.18 14.25,2 14,2H10C9.75,2 9.54,2.18 9.5,2.42L9.13,5.07C8.5,5.32 7.96,5.66 7.44,6.05L4.95,5.05C4.73,4.96 4.46,5.05 4.34,5.27L2.34,8.73C2.21,8.95 2.27,9.22 2.46,9.37L4.57,11C4.53,11.34 4.5,11.67 4.5,12C4.5,12.33 4.53,12.65 4.57,12.97L2.46,14.63C2.27,14.78 2.21,15.05 2.34,15.27L4.34,18.73C4.46,18.95 4.73,19.03 4.95,18.95L7.44,17.94C7.96,18.34 8.5,18.68 9.13,18.93L9.5,21.58C9.54,21.82 9.75,22 10,22H14C14.25,22 14.46,21.82 14.5,21.58L14.87,18.93C15.5,18.67 16.04,18.34 16.56,17.94L19.05,18.95C19.27,19.03 19.54,18.95 19.66,18.73L21.66,15.27C21.78,15.05 21.73,14.78 21.54,14.63L19.43,12.97Z" Fill="#95A5A6" Width="16" Height="16" Stretch="Uniform"/>
                    </MenuItem.Icon>
                </MenuItem>
                <Separator/>
                <MenuItem Header="退出" Click="Exit_Click">
                    <MenuItem.Icon>
                        <Path Data="{StaticResource IconExit}" Fill="#E74C3C" Width="16" Height="16" Stretch="Uniform"/>
                    </MenuItem.Icon>
                </MenuItem>
            </MenuItem>
        </Menu>

        <!-- Annotation Toolbar -->
        <ToolBarTray DockPanel.Dock="Top" Background="White" Visibility="{Binding IsPdfView, Converter={StaticResource BoolToVisibilityConverter}}">
            <ToolBar Background="White" Padding="12,8">
                <Button Style="{StaticResource IconButtonStyle}" Command="{Binding OpenFileCommand}" ToolTip="打开 PDF (Ctrl+O)">
                    <Path Data="{StaticResource IconOpen}" Fill="#3498DB" Width="20" Height="20" Stretch="Uniform"/>
                </Button>
                <Button Style="{StaticResource IconButtonStyle}" Command="{Binding SaveCommand}" ToolTip="保存批注 (Ctrl+S)">
                    <Path Data="{StaticResource IconSave}" Fill="#27AE60" Width="20" Height="20" Stretch="Uniform"/>
                </Button>
                <Separator Margin="8,0"/>
                <ToggleButton Style="{StaticResource IconToggleButtonStyle}"
                              IsChecked="{Binding Toolbar.IsPenActive, Mode=OneWay}"
                              Command="{Binding Toolbar.SelectPenCommand}" ToolTip="画笔">
                    <Path Data="{StaticResource IconPen}" Width="20" Height="20" Stretch="Uniform">
                        <Path.Fill>
                            <MultiBinding Converter="{StaticResource PenIconColorConverter}">
                                <Binding Path="Toolbar.IsPenActive"/>
                                <Binding Path="Toolbar.SelectedColor"/>
                            </MultiBinding>
                        </Path.Fill>
                    </Path>
                </ToggleButton>
                <ToggleButton Style="{StaticResource IconToggleButtonStyle}"
                              IsChecked="{Binding Toolbar.IsEraserActive, Mode=OneWay}"
                              Command="{Binding Toolbar.SelectEraserCommand}" ToolTip="橡皮">
                    <Path Data="{StaticResource IconEraser}" Fill="#95A5A6" Width="20" Height="20" Stretch="Uniform"/>
                </ToggleButton>
                <Button Style="{StaticResource IconButtonStyle}" Command="{Binding Toolbar.ClearAllCommand}" ToolTip="清空所有批注">
                    <Path Data="{StaticResource IconClear}" Fill="#E74C3C" Width="20" Height="20" Stretch="Uniform"/>
                </Button>
                <Separator Margin="8,0"/>
                <!-- Color Palette -->
                <TextBlock Text="颜色" VerticalAlignment="Center" Margin="8,0,8,0" Foreground="#34495E" FontWeight="SemiBold" FontSize="13"/>
                <ItemsControl ItemsSource="{Binding Toolbar.PenColors}" Margin="4,0">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Width="28" Height="28" Margin="3" BorderThickness="3" Cursor="Hand" CornerRadius="14"
                                    Background="{Binding Converter={StaticResource ColorToBrushConverter}}"
                                    MouseLeftButtonDown="ColorSwatch_Click" Tag="{Binding}">
                                <Border.Effect>
                                    <DropShadowEffect Color="#000000" BlurRadius="4" ShadowDepth="1" Opacity="0.2"/>
                                </Border.Effect>
                                <Border.BorderBrush>
                                    <MultiBinding Converter="{StaticResource ColorSelectedConverter}">
                                        <Binding/>
                                        <Binding Path="DataContext.Toolbar.SelectedColor" RelativeSource="{RelativeSource AncestorType=Window}"/>
                                    </MultiBinding>
                                </Border.BorderBrush>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <Separator Margin="8,0"/>
                <!-- Pen Size -->
                <TextBlock Text="笔粗" VerticalAlignment="Center" Margin="8,0,6,0" Foreground="#34495E" FontWeight="SemiBold" FontSize="13"/>
                <Slider Value="{Binding Toolbar.PenSize}" Minimum="1" Maximum="20" Width="80"
                        VerticalAlignment="Center" ToolTip="画笔粗细" Foreground="#3498DB"/>
                <Separator Margin="8,0"/>
                <!-- Eraser Size -->
                <TextBlock Text="擦头" VerticalAlignment="Center" Margin="8,0,6,0" Foreground="#34495E" FontWeight="SemiBold" FontSize="13"/>
                <Slider Value="{Binding Toolbar.EraserSize}" Minimum="5" Maximum="50" Width="90"
                        VerticalAlignment="Center" ToolTip="橡皮大小" Foreground="#95A5A6"/>
                <Separator Margin="8,0"/>
                <!-- Zoom -->
                <Button Style="{StaticResource IconButtonStyle}" Command="{Binding ZoomOutCommand}" ToolTip="缩小">
                    <Path Data="{StaticResource IconZoomOut}" Fill="#7F8C8D" Width="20" Height="20" Stretch="Uniform"/>
                </Button>
                <TextBlock Text="{Binding ZoomPercent}" VerticalAlignment="Center" Margin="8,0" MinWidth="50"
                           TextAlignment="Center" Foreground="#2C3E50" FontWeight="Bold" FontSize="14"/>
                <Button Style="{StaticResource IconButtonStyle}" Command="{Binding ZoomInCommand}" ToolTip="放大">
                    <Path Data="{StaticResource IconZoomIn}" Fill="#7F8C8D" Width="20" Height="20" Stretch="Uniform"/>
                </Button>
                <Button Style="{StaticResource IconButtonStyle}" Command="{Binding ZoomResetCommand}" ToolTip="重置缩放">
                    <Path Data="{StaticResource IconZoomReset}" Fill="#7F8C8D" Width="20" Height="20" Stretch="Uniform"/>
                </Button>
            </ToolBar>
        </ToolBarTray>

        <!-- Clear Slider Panel -->
        <Border DockPanel.Dock="Top" Background="#FFF3CD" BorderBrush="#FFC107" BorderThickness="0,0,0,2"
                Padding="20,12" Visibility="{Binding Toolbar.ShowClearSlider, Converter={StaticResource BoolToVisibilityConverter}}">
            <Grid MaxWidth="600" HorizontalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,20,0">
                    <Path Data="M13,14H11V10H13M13,18H11V16H13M1,21H23L12,2L1,21Z" Fill="#FF9800" Width="24" Height="24" Stretch="Uniform" Margin="0,0,12,0"/>
                    <TextBlock Text="滑动到右侧以清空所有批注" FontSize="14" FontWeight="SemiBold" Foreground="#856404" VerticalAlignment="Center"/>
                </StackPanel>

                <Slider Grid.Column="1" Value="{Binding Toolbar.ClearSliderValue}" Minimum="0" Maximum="100"
                        VerticalAlignment="Center" Margin="0,0,20,0" Height="40">
                    <Slider.Resources>
                        <Style TargetType="Thumb">
                            <Setter Property="Width" Value="36"/>
                            <Setter Property="Height" Value="36"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Thumb">
                                        <Border Background="#FF9800" CornerRadius="18" BorderBrush="White" BorderThickness="3">
                                            <Border.Effect>
                                                <DropShadowEffect Color="#000000" BlurRadius="8" ShadowDepth="2" Opacity="0.3"/>
                                            </Border.Effect>
                                            <Path Data="M8.59,16.58L13.17,12L8.59,7.41L10,6L16,12L10,18L8.59,16.58Z"
                                                  Fill="White" Width="16" Height="16" Stretch="Uniform"
                                                  HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </Slider.Resources>
                    <Slider.Style>
                        <Style TargetType="Slider">
                            <Setter Property="Foreground" Value="#FF9800"/>
                            <Setter Property="Background" Value="#FFE5B4"/>
                        </Style>
                    </Slider.Style>
                </Slider>

                <Button Grid.Column="2" Command="{Binding Toolbar.ToggleClearSliderCommand}" Padding="12,8"
                        Background="Transparent" BorderBrush="#856404" BorderThickness="1" Cursor="Hand">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}"
                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                BorderThickness="{TemplateBinding BorderThickness}"
                                                CornerRadius="4" Padding="{TemplateBinding Padding}">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Background" Value="#856404"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </Button.Style>
                    <TextBlock Text="取消" FontWeight="SemiBold" Foreground="#856404"/>
                </Button>
            </Grid>
        </Border>

        <!-- Multi-View Content Area -->
        <Grid>
            <!-- Home Page -->
            <ContentControl Visibility="{Binding IsHomeView, Converter={StaticResource BoolToVisibilityConverter}}">
                <ContentControl.Content>
                    <Grid Background="#F8F9FA">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- Header -->
                        <Border Grid.Row="0" Background="White" Padding="40,30" BorderBrush="#E0E0E0" BorderThickness="0,0,0,1">
                            <StackPanel>
                                <TextBlock Text="PDF 教学批注工具" FontSize="32" FontWeight="Bold" Foreground="#2C3E50"/>
                                <TextBlock Text="轻松为 PDF 添加批注和标记" FontSize="16" Foreground="#7F8C8D" Margin="0,8,0,0"/>
                            </StackPanel>
                        </Border>

                        <!-- Content -->
                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                            <StackPanel Margin="40,30">
                                <!-- Quick Actions -->
                                <TextBlock Text="快速操作" FontSize="20" FontWeight="SemiBold" Foreground="#34495E" Margin="0,0,0,16"/>
                                <Button Command="{Binding OpenFileCommand}" Cursor="Hand" Background="White" BorderBrush="#E0E0E0"
                                        BorderThickness="1" Padding="30,20" Margin="0,0,0,40" HorizontalAlignment="Left">
                                    <Button.Style>
                                        <Style TargetType="Button">
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="Button">
                                                        <Border Background="{TemplateBinding Background}"
                                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                                BorderThickness="{TemplateBinding BorderThickness}"
                                                                CornerRadius="8" Padding="{TemplateBinding Padding}">
                                                            <Border.Effect>
                                                                <DropShadowEffect Color="#000000" BlurRadius="8" ShadowDepth="2" Opacity="0.1"/>
                                                            </Border.Effect>
                                                            <ContentPresenter/>
                                                        </Border>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter Property="Background" Value="#E3F2FD"/>
                                                            </Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                        </Style>
                                    </Button.Style>
                                    <StackPanel>
                                        <Path Data="{StaticResource IconOpen}" Fill="#3498DB" Width="48" Height="48" Stretch="Uniform" HorizontalAlignment="Center"/>
                                        <TextBlock Text="打开 PDF" FontSize="16" FontWeight="SemiBold" Foreground="#2C3E50"
                                                   HorizontalAlignment="Center" Margin="0,12,0,0"/>
                                        <TextBlock Text="浏览并打开 PDF 文件" FontSize="12" Foreground="#7F8C8D"
                                                   HorizontalAlignment="Center" Margin="0,4,0,0"/>
                                    </StackPanel>
                                </Button>

                                <!-- Recent Files -->
                                <TextBlock Text="最近访问" FontSize="20" FontWeight="SemiBold" Foreground="#34495E" Margin="0,0,0,16"/>

                                <!-- Recent Files List -->
                                <ItemsControl ItemsSource="{Binding RecentFiles}" Visibility="{Binding HasRecentFiles, Converter={StaticResource InverseBoolToVisibilityConverter}}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Button Tag="{Binding FilePath}" Click="RecentFile_Click" Cursor="Hand"
                                                    Background="White" BorderBrush="#E0E0E0" BorderThickness="1"
                                                    Padding="20" Margin="0,0,0,12" HorizontalContentAlignment="Stretch">
                                                <Button.Style>
                                                    <Style TargetType="Button">
                                                        <Setter Property="Template">
                                                            <Setter.Value>
                                                                <ControlTemplate TargetType="Button">
                                                                    <Border Background="{TemplateBinding Background}"
                                                                            BorderBrush="{TemplateBinding BorderBrush}"
                                                                            BorderThickness="{TemplateBinding BorderThickness}"
                                                                            CornerRadius="6" Padding="{TemplateBinding Padding}">
                                                                        <Border.Effect>
                                                                            <DropShadowEffect Color="#000000" BlurRadius="6" ShadowDepth="1" Opacity="0.08"/>
                                                                        </Border.Effect>
                                                                        <ContentPresenter/>
                                                                    </Border>
                                                                    <ControlTemplate.Triggers>
                                                                        <Trigger Property="IsMouseOver" Value="True">
                                                                            <Setter Property="Background" Value="#F5F5F5"/>
                                                                        </Trigger>
                                                                    </ControlTemplate.Triggers>
                                                                </ControlTemplate>
                                                            </Setter.Value>
                                                        </Setter>
                                                    </Style>
                                                </Button.Style>
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>

                                                    <Path Grid.Column="0" Data="M14,2H6A2,2 0 0,0 4,4V20A2,2 0 0,0 6,22H18A2,2 0 0,0 20,20V8L14,2M18,20H6V4H13V9H18V20Z"
                                                          Fill="#E74C3C" Width="32" Height="32" Stretch="Uniform" Margin="0,0,16,0"/>

                                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding FileName}" FontSize="15" FontWeight="SemiBold"
                                                                   Foreground="#2C3E50" TextTrimming="CharacterEllipsis"/>
                                                        <TextBlock FontSize="12" Foreground="#7F8C8D" Margin="0,4,0,0">
                                                            <Run Text="{Binding PageCount, StringFormat='{}{0} 页', Mode=OneWay}"/>
                                                            <Run Text=" • "/>
                                                            <Run Text="{Binding LastAccessed, StringFormat='上次访问: {0:yyyy-MM-dd HH:mm}', Mode=OneWay}"/>
                                                        </TextBlock>
                                                    </StackPanel>

                                                    <Path Grid.Column="2" Data="M8.59,16.58L13.17,12L8.59,7.41L10,6L16,12L10,18L8.59,16.58Z"
                                                          Fill="#BDC3C7" Width="24" Height="24" Stretch="Uniform" VerticalAlignment="Center"/>
                                                </Grid>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <!-- Empty State -->
                                <Border Background="White" BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="6"
                                        Padding="40" Visibility="{Binding HasRecentFiles, Converter={StaticResource BoolToVisibilityConverter}}">
                                    <StackPanel HorizontalAlignment="Center">
                                        <Path Data="M14,2H6A2,2 0 0,0 4,4V20A2,2 0 0,0 6,22H18A2,2 0 0,0 20,20V8L14,2M18,20H6V4H13V9H18V20Z"
                                              Fill="#BDC3C7" Width="64" Height="64" Stretch="Uniform" HorizontalAlignment="Center"/>
                                        <TextBlock Text="暂无最近文件" FontSize="16" Foreground="#7F8C8D"
                                                   HorizontalAlignment="Center" Margin="0,16,0,0"/>
                                        <TextBlock Text="打开一个 PDF 文件开始使用" FontSize="13" Foreground="#95A5A6"
                                                   HorizontalAlignment="Center" Margin="0,4,0,0"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>
                </ContentControl.Content>
            </ContentControl>

            <!-- Settings Page -->
            <ContentControl Visibility="{Binding IsSettingsView, Converter={StaticResource BoolToVisibilityConverter}}">
                <ContentControl.Content>
                    <Grid Background="#F8F9FA">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <Border Grid.Row="0" Background="White" Padding="40,30" BorderBrush="#E0E0E0" BorderThickness="0,0,0,1">
                            <StackPanel>
                                <TextBlock Text="设置" FontSize="32" FontWeight="Bold" Foreground="#2C3E50"/>
                                <TextBlock Text="自定义应用程序行为" FontSize="16" Foreground="#7F8C8D" Margin="0,8,0,0"/>
                            </StackPanel>
                        </Border>

                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                            <StackPanel Margin="40,30" MaxWidth="700" HorizontalAlignment="Left">
                                <TextBlock Text="常规设置" FontSize="20" FontWeight="SemiBold" Foreground="#34495E" Margin="0,0,0,16"/>

                                <Border Background="White" BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="6" Padding="24" Margin="0,0,0,20">
                                    <Border.Effect>
                                        <DropShadowEffect Color="#000000" BlurRadius="6" ShadowDepth="1" Opacity="0.08"/>
                                    </Border.Effect>
                                    <StackPanel>
                                        <CheckBox IsChecked="{Binding Settings.AutoSaveAnnotations}" Foreground="#2C3E50" FontSize="14">
                                            <TextBlock Text="自动保存批注" FontWeight="SemiBold"/>
                                        </CheckBox>
                                        <TextBlock Text="关闭文件时自动保存批注，无需手动保存" FontSize="12" Foreground="#7F8C8D" Margin="28,4,0,0"/>

                                        <CheckBox IsChecked="{Binding Settings.ShowWelcomeScreen}" Foreground="#2C3E50" FontSize="14" Margin="0,20,0,0">
                                            <TextBlock Text="启动时显示主页" FontWeight="SemiBold"/>
                                        </CheckBox>
                                        <TextBlock Text="应用启动时显示主页和最近文件" FontSize="12" Foreground="#7F8C8D" Margin="28,4,0,0"/>
                                    </StackPanel>
                                </Border>

                                <Button Click="SaveSettings_Click" Padding="24,12" HorizontalAlignment="Left"
                                        Background="#27AE60" Foreground="White" BorderThickness="0" Cursor="Hand" Margin="0,20,0,40">
                                    <Button.Style>
                                        <Style TargetType="Button">
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="Button">
                                                        <Border Background="{TemplateBinding Background}"
                                                                CornerRadius="6" Padding="{TemplateBinding Padding}">
                                                            <Border.Effect>
                                                                <DropShadowEffect Color="#000000" BlurRadius="8" ShadowDepth="2" Opacity="0.15"/>
                                                            </Border.Effect>
                                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                        </Border>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter Property="Background" Value="#229954"/>
                                                            </Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                        </Style>
                                    </Button.Style>
                                    <StackPanel Orientation="Horizontal">
                                        <Path Data="{StaticResource IconSave}" Fill="White" Width="18" Height="18" Stretch="Uniform" Margin="0,0,10,0"/>
                                        <TextBlock Text="保存设置" FontSize="15" FontWeight="SemiBold"/>
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>
                </ContentControl.Content>
            </ContentControl>

            <!-- PDF View (existing) -->
            <ScrollViewer x:Name="PdfScrollViewer"
                          Visibility="{Binding IsPdfView, Converter={StaticResource BoolToVisibilityConverter}}"
                          HorizontalScrollBarVisibility="Auto"
                          VerticalScrollBarVisibility="Auto"
                          PreviewMouseWheel="ScrollViewer_PreviewMouseWheel"
                          SizeChanged="ScrollViewer_SizeChanged"
                          Background="#F8F9FA">
            <ItemsControl ItemsSource="{Binding Pages}" x:Name="PagesControl">
                <ItemsControl.LayoutTransform>
                    <ScaleTransform ScaleX="{Binding ZoomLevel}" ScaleY="{Binding ZoomLevel}"/>
                </ItemsControl.LayoutTransform>
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Vertical" HorizontalAlignment="Center"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Margin="0,10" HorizontalAlignment="Center" Background="White"
                                BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="4">
                            <Border.Effect>
                                <DropShadowEffect Color="#000000" BlurRadius="12" ShadowDepth="3" Opacity="0.15"/>
                            </Border.Effect>
                            <Grid HorizontalAlignment="Center">
                                <Image Source="{Binding Image}" Stretch="None"/>
                                <InkCanvas Strokes="{Binding Strokes}"
                                           Background="Transparent"
                                           EditingMode="{Binding DataContext.Toolbar.ActiveTool, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource ToolModeConverter}}"
                                           DefaultDrawingAttributes="{Binding DataContext.Toolbar.DrawingAttributes, RelativeSource={RelativeSource AncestorType=Window}}"/>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
        </Grid>
    </DockPanel>
</Window>
