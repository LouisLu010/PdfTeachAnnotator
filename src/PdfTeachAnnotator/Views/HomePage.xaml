<UserControl x:Class="PdfTeachAnnotator.Views.HomePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="600" d:DesignWidth="900"
             Background="#F8F9FA">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="White" Padding="40,30" BorderBrush="#E0E0E0" BorderThickness="0,0,0,1">
            <StackPanel>
                <TextBlock Text="PDF 教学批注工具" FontSize="32" FontWeight="Bold" Foreground="#2C3E50"/>
                <TextBlock Text="轻松为 PDF 添加批注和标记" FontSize="16" Foreground="#7F8C8D" Margin="0,8,0,0"/>
            </StackPanel>
        </Border>

        <!-- Content -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="40,30">
                <!-- Quick Actions -->
                <TextBlock Text="快速操作" FontSize="20" FontWeight="SemiBold" Foreground="#34495E" Margin="0,0,0,16"/>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,40">
                    <Button Click="OpenFile_Click" Cursor="Hand" Background="White" BorderBrush="#E0E0E0"
                            BorderThickness="1" Padding="30,20" Margin="0,0,20,0">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}"
                                                    BorderBrush="{TemplateBinding BorderBrush}"
                                                    BorderThickness="{TemplateBinding BorderThickness}"
                                                    CornerRadius="8" Padding="{TemplateBinding Padding}">
                                                <Border.Effect>
                                                    <DropShadowEffect Color="#000000" BlurRadius="8" ShadowDepth="2" Opacity="0.1"/>
                                                </Border.Effect>
                                                <ContentPresenter/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter Property="Background" Value="#E3F2FD"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </Button.Style>
                        <StackPanel>
                            <Path Data="M19,20H4C2.89,20 2,19.1 2,18V6C2,4.89 2.89,4 4,4H10L12,6H19A2,2 0 0,1 21,8H4V18L6.14,10H22.14L20,18C19.79,18.84 19,20 19,20Z"
                                  Fill="#3498DB" Width="48" Height="48" Stretch="Uniform" HorizontalAlignment="Center"/>
                            <TextBlock Text="打开 PDF" FontSize="16" FontWeight="SemiBold" Foreground="#2C3E50"
                                       HorizontalAlignment="Center" Margin="0,12,0,0"/>
                            <TextBlock Text="浏览并打开 PDF 文件" FontSize="12" Foreground="#7F8C8D"
                                       HorizontalAlignment="Center" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Button>
                </StackPanel>

                <!-- Recent Files -->
                <TextBlock Text="最近访问" FontSize="20" FontWeight="SemiBold" Foreground="#34495E" Margin="0,0,0,16"/>
                <ItemsControl ItemsSource="{Binding RecentFiles}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Click="RecentFile_Click" Tag="{Binding FilePath}" Cursor="Hand"
                                    Background="White" BorderBrush="#E0E0E0" BorderThickness="1"
                                    Padding="20" Margin="0,0,0,12" HorizontalContentAlignment="Stretch">
                                <Button.Style>
                                    <Style TargetType="Button">
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="Button">
                                                    <Border Background="{TemplateBinding Background}"
                                                            BorderBrush="{TemplateBinding BorderBrush}"
                                                            BorderThickness="{TemplateBinding BorderThickness}"
                                                            CornerRadius="6" Padding="{TemplateBinding Padding}">
                                                        <Border.Effect>
                                                            <DropShadowEffect Color="#000000" BlurRadius="6" ShadowDepth="1" Opacity="0.08"/>
                                                        </Border.Effect>
                                                        <ContentPresenter/>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter Property="Background" Value="#F5F5F5"/>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </Button.Style>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <Path Grid.Column="0" Data="M14,2H6A2,2 0 0,0 4,4V20A2,2 0 0,0 6,22H18A2,2 0 0,0 20,20V8L14,2M18,20H6V4H13V9H18V20Z"
                                          Fill="#E74C3C" Width="32" Height="32" Stretch="Uniform" Margin="0,0,16,0"/>

                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding FileName}" FontSize="15" FontWeight="SemiBold"
                                                   Foreground="#2C3E50" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock FontSize="12" Foreground="#7F8C8D" Margin="0,4,0,0">
                                            <Run Text="{Binding PageCount, StringFormat='{}{0} 页'}"/>
                                            <Run Text=" • "/>
                                            <Run Text="{Binding LastAccessed, StringFormat='上次访问: {0:yyyy-MM-dd HH:mm}'}"/>
                                        </TextBlock>
                                    </StackPanel>

                                    <Path Grid.Column="2" Data="M8.59,16.58L13.17,12L8.59,7.41L10,6L16,12L10,18L8.59,16.58Z"
                                          Fill="#BDC3C7" Width="24" Height="24" Stretch="Uniform" VerticalAlignment="Center"/>
                                </Grid>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- Empty State -->
                <Border Background="White" BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="6"
                        Padding="40" Margin="0,0,0,20" Visibility="{Binding HasRecentFiles, Converter={StaticResource BoolToVisibilityConverter}}">
                    <StackPanel HorizontalAlignment="Center">
                        <Path Data="M14,2H6A2,2 0 0,0 4,4V20A2,2 0 0,0 6,22H18A2,2 0 0,0 20,20V8L14,2M18,20H6V4H13V9H18V20Z"
                              Fill="#BDC3C7" Width="64" Height="64" Stretch="Uniform" HorizontalAlignment="Center"/>
                        <TextBlock Text="暂无最近文件" FontSize="16" Foreground="#7F8C8D"
                                   HorizontalAlignment="Center" Margin="0,16,0,0"/>
                        <TextBlock Text="打开一个 PDF 文件开始使用" FontSize="13" Foreground="#95A5A6"
                                   HorizontalAlignment="Center" Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
