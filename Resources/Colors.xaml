<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ========================================
         配色系统 - Light Theme
         ======================================== -->

    <!-- Primary Colors -->
    <SolidColorBrush x:Key="PrimaryBrush" Color="#2563EB"/>
    <SolidColorBrush x:Key="PrimaryHoverBrush" Color="#1D4ED8"/>
    <SolidColorBrush x:Key="PrimaryPressedBrush" Color="#1E40AF"/>
    <SolidColorBrush x:Key="PrimarySurfaceBrush" Color="#EFF6FF"/>
    <SolidColorBrush x:Key="PrimaryLightBrush" Color="#DBEAFE"/>

    <!-- Surface Colors -->
    <SolidColorBrush x:Key="SurfaceBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="SurfaceSecondaryBrush" Color="#F8FAFC"/>
    <SolidColorBrush x:Key="SurfaceTertiaryBrush" Color="#F1F5F9"/>

    <!-- Border Colors -->
    <SolidColorBrush x:Key="BorderBrush" Color="#E2E8F0"/>
    <SolidColorBrush x:Key="BorderLightBrush" Color="#F1F5F9"/>
    <SolidColorBrush x:Key="BorderDarkBrush" Color="#CBD5E1"/>

    <!-- Text Colors -->
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#0F172A"/>
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#64748B"/>
    <SolidColorBrush x:Key="TextTertiaryBrush" Color="#94A3B8"/>
    <SolidColorBrush x:Key="TextDisabledBrush" Color="#CBD5E1"/>

    <!-- Semantic Colors -->
    <SolidColorBrush x:Key="SuccessBrush" Color="#10B981"/>
    <SolidColorBrush x:Key="SuccessLightBrush" Color="#D1FAE5"/>
    <SolidColorBrush x:Key="WarningBrush" Color="#F59E0B"/>
    <SolidColorBrush x:Key="WarningLightBrush" Color="#FEF3C7"/>
    <SolidColorBrush x:Key="ErrorBrush" Color="#EF4444"/>
    <SolidColorBrush x:Key="ErrorLightBrush" Color="#FEE2E2"/>
    <SolidColorBrush x:Key="InfoBrush" Color="#3B82F6"/>
    <SolidColorBrush x:Key="InfoLightBrush" Color="#DBEAFE"/>

    <!-- Tool Colors -->
    <SolidColorBrush x:Key="PenBrush" Color="#2563EB"/>
    <SolidColorBrush x:Key="EraserBrush" Color="#64748B"/>
    <SolidColorBrush x:Key="HighlighterBrush" Color="#FBBF24"/>
    <SolidColorBrush x:Key="TextToolBrush" Color="#0F172A"/>

    <!-- Annotation Palette Colors -->
    <SolidColorBrush x:Key="Red1" Color="#FEE2E2"/>
    <SolidColorBrush x:Key="Red2" Color="#FECACA"/>
    <SolidColorBrush x:Key="Red3" Color="#FCA5A5"/>
    <SolidColorBrush x:Key="Red4" Color="#F87171"/>
    <SolidColorBrush x:Key="Red5" Color="#EF4444"/>
    <SolidColorBrush x:Key="Red6" Color="#DC2626"/>

    <SolidColorBrush x:Key="Blue1" Color="#DBEAFE"/>
    <SolidColorBrush x:Key="Blue2" Color="#BFDBFE"/>
    <SolidColorBrush x:Key="Blue3" Color="#93C5FD"/>
    <SolidColorBrush x:Key="Blue4" Color="#60A5FA"/>
    <SolidColorBrush x:Key="Blue5" Color="#3B82F6"/>
    <SolidColorBrush x:Key="Blue6" Color="#2563EB"/>

    <SolidColorBrush x:Key="Green1" Color="#D1FAE5"/>
    <SolidColorBrush x:Key="Green2" Color="#A7F3D0"/>
    <SolidColorBrush x:Key="Green3" Color="#6EE7B7"/>
    <SolidColorBrush x:Key="Green4" Color="#34D399"/>
    <SolidColorBrush x:Key="Green5" Color="#10B981"/>
    <SolidColorBrush x:Key="Green6" Color="#059669"/>

    <SolidColorBrush x:Key="Yellow1" Color="#FEF3C7"/>
    <SolidColorBrush x:Key="Yellow2" Color="#FDE68A"/>
    <SolidColorBrush x:Key="Yellow3" Color="#FCD34D"/>
    <SolidColorBrush x:Key="Yellow4" Color="#FBBF24"/>
    <SolidColorBrush x:Key="Yellow5" Color="#F59E0B"/>
    <SolidColorBrush x:Key="Yellow6" Color="#D97706"/>

    <SolidColorBrush x:Key="Purple1" Color="#E9D5FF"/>
    <SolidColorBrush x:Key="Purple2" Color="#D8B4FE"/>
    <SolidColorBrush x:Key="Purple3" Color="#C084FC"/>
    <SolidColorBrush x:Key="Purple4" Color="#A855F7"/>
    <SolidColorBrush x:Key="Purple5" Color="#9333EA"/>
    <SolidColorBrush x:Key="Purple6" Color="#7E22CE"/>

    <SolidColorBrush x:Key="Gray1" Color="#F1F5F9"/>
    <SolidColorBrush x:Key="Gray2" Color="#E2E8F0"/>
    <SolidColorBrush x:Key="Gray3" Color="#CBD5E1"/>
    <SolidColorBrush x:Key="Gray4" Color="#94A3B8"/>
    <SolidColorBrush x:Key="Gray5" Color="#64748B"/>
    <SolidColorBrush x:Key="Gray6" Color="#475569"/>

    <!-- ========================================
         间距系统（8pt Grid）
         ======================================== -->

    <Thickness x:Key="SpacingXS">4</Thickness>
    <Thickness x:Key="SpacingSM">8</Thickness>
    <Thickness x:Key="SpacingMD">12</Thickness>
    <Thickness x:Key="SpacingLG">16</Thickness>
    <Thickness x:Key="SpacingXL">24</Thickness>
    <Thickness x:Key="Spacing2XL">32</Thickness>
    <Thickness x:Key="Spacing3XL">48</Thickness>

    <System:Double xmlns:System="clr-namespace:System;assembly=mscorlib" x:Key="SpacingXSValue">4</System:Double>
    <System:Double xmlns:System="clr-namespace:System;assembly=mscorlib" x:Key="SpacingSMValue">8</System:Double>
    <System:Double xmlns:System="clr-namespace:System;assembly=mscorlib" x:Key="SpacingMDValue">12</System:Double>
    <System:Double xmlns:System="clr-namespace:System;assembly=mscorlib" x:Key="SpacingLGValue">16</System:Double>
    <System:Double xmlns:System="clr-namespace:System;assembly=mscorlib" x:Key="SpacingXLValue">24</System:Double>

    <!-- ========================================
         圆角系统
         ======================================== -->

    <CornerRadius x:Key="RadiusSmall">4</CornerRadius>
    <CornerRadius x:Key="RadiusMedium">8</CornerRadius>
    <CornerRadius x:Key="RadiusLarge">12</CornerRadius>
    <CornerRadius x:Key="RadiusXLarge">16</CornerRadius>
    <CornerRadius x:Key="RadiusFull">9999</CornerRadius>

    <!-- ========================================
         阴影效果
         ======================================== -->

    <DropShadowEffect x:Key="ShadowSmall" Color="Black" Opacity="0.05" ShadowDepth="1" BlurRadius="2"/>
    <DropShadowEffect x:Key="ShadowMedium" Color="Black" Opacity="0.07" ShadowDepth="4" BlurRadius="6"/>
    <DropShadowEffect x:Key="ShadowLarge" Color="Black" Opacity="0.1" ShadowDepth="10" BlurRadius="15"/>
    <DropShadowEffect x:Key="ShadowXLarge" Color="Black" Opacity="0.15" ShadowDepth="20" BlurRadius="25"/>

    <!-- ========================================
         字体大小
         ======================================== -->

    <System:Double xmlns:System="clr-namespace:System;assembly=mscorlib" x:Key="FontSizeXS">11</System:Double>
    <System:Double xmlns:System="clr-namespace:System;assembly=mscorlib" x:Key="FontSizeSM">12</System:Double>
    <System:Double xmlns:System="clr-namespace:System;assembly=mscorlib" x:Key="FontSizeMD">13</System:Double>
    <System:Double xmlns:System="clr-namespace:System;assembly=mscorlib" x:Key="FontSizeLG">14</System:Double>
    <System:Double xmlns:System="clr-namespace:System;assembly=mscorlib" x:Key="FontSizeXL">16</System:Double>
    <System:Double xmlns:System="clr-namespace:System;assembly=mscorlib" x:Key="FontSize2XL">20</System:Double>
    <System:Double xmlns:System="clr-namespace:System;assembly=mscorlib" x:Key="FontSize3XL">24</System:Double>

    <!-- ========================================
         动画时长
         ======================================== -->

    <Duration x:Key="AnimationFast">0:0:0.15</Duration>
    <Duration x:Key="AnimationMedium">0:0:0.25</Duration>
    <Duration x:Key="AnimationSlow">0:0:0.35</Duration>

</ResourceDictionary>
